{
  "name": "mistsea-phase1",
  "version": "0.2.0-phase2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/unit.test.ts tests/dialogue.test.ts",
    "test:integration": "node --import tsx --test --test-isolation=none tests/dialogue.integration.ts",
    "test:e2e": "playwright test",
    "build": "vite build --outDir release/client && tsc -p tsconfig.server.json",
    "start": "node release/server/src/server/index.js",
    "assets:prepare": "python3 scripts/assets/prepare.py",
    "assets:fetch": "python3 scripts/assets/fetch.py",
    "world:generate": "python3 scripts/world/generate.py"
  },
  "dependencies": {
    "@fastify/static": "10.1.12",
    "fastify": "5.12.8",
    "phaser": "4.2.1",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "prettier": "3.10.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
