  private offerGift(next: SaveState, id: string, from: Contributor, amount: MaterialAmount, now: number): Result {
    const result = (ok: boolean, code: string, text: string) =>
      ({ ...this.giftResult(id, ok, code, text), offerId: id, actor: from });
    if (!this.canTalkToCenyan()) return result(false, "TOO_FAR", "请走近后再提议赠送。");
    if (next.gift && next.gift.expiresAt > now)
      return result(false, "GIFT_BUSY", "请先处理现有的赠送提议。");
    const source = from === "player" ? next.inventory : next.cenyan.bag;
    if (source[amount.item] < amount.qty)
      return result(false, "GIFT_NO_STOCK", "提议赠送的材料数量超过自己的持有量。");
    next.gift = { item: amount.item, qty: amount.qty, id, from, expiresAt: now + giftMs };
    return result(true, "GIFT_OFFERED", `已提议赠送${items[amount.item]} ×${amount.qty}，等待对方决定。`);
  }

