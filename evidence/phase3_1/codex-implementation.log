#dialogue-mode {
  margin-inline-start: auto;
  color: #f3d79d;
  font-size: 11px;
}
#dialogue-mode[data-mode="live"] {
  color: #c4d795;
}
#dialogue-transcript {
  min-height: 42px;
  max-height: 155px;
  overflow: auto;
  margin: 9px 0;
  padding: 5px 8px;
  background: #111f1e;
  border: 1px solid #425049;
}
#dialogue-transcript p {
  margin: 4px 0 8px;
  display: grid;
  grid-template-columns: 4.5em 1fr;
  line-height: 1.5;
}
#dialogue-transcript span {
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}
#dialogue-transcript strong {
  color: #eac58a;
}
#dialogue-pending,
#dialogue-error {
  margin: 5px 0;
  color: #f6d0a1;
}
.dialogue-actions,
.dialogue-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-bottom: 6px;
}
.dialogue-compose {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 6px;
  align-items: end;
}
.dialogue-input-label {
  grid-column: 1 / -1;
  font-size: 12px;
}
#dialogue-input {
  width: 100%;
  resize: vertical;
  max-height: 72px;
  color: #eee9d8;
  background: #101e1d;
  border: 1px solid #72816c;
  border-radius: 4px;
  padding: 5px;
  font: inherit;
  font-size: 13px;
}
@media (max-width: 540px) {
  #cenyan-dialogue {
    inset: auto 6px 6px;
    width: calc(100% - 12px);
    max-height: calc(100% - 12px);
    overflow: auto;
    padding: 8px;
  }
  #dialogue-transcript {
    max-height: 90px;
  }
  .dialogue-header {
    gap: 6px;
  }
}

.cenyan-status {
  margin: 0.75rem 0 0;
  color: var(--muted, #bfc8b2);
  font-size: 0.85rem;
}

.cenyan-debug {
  margin-top: 0.5rem;
  padding-top: 0.5rem;
  border-top: 1px solid #516458;
  font-size: 0.82rem;
  overflow-wrap: anywhere;
}

.cenyan-debug summary { cursor: pointer; }
.cenyan-debug dl { margin: 0.65rem 0; }
.cenyan-debug dt { font-weight: bold; }
.cenyan-debug dd { margin: 0 0 0.45rem; }
.cenyan-debug h3 { font-size: inherit; }
.cenyan-debug li { line-height: 1.45; }
.dialogue-suggestions { flex-wrap: wrap; }

.material-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  padding: 0.4rem 0.65rem;
import { test, expect, type Page } from "@playwright/test";
import { spawn, type ChildProcess } from "node:child_process";
import { once } from "node:events";
import {
  closeSync,
  mkdirSync,
  mkdtempSync,
  openSync,
  readFileSync,
  rmSync,
  writeFileSync,
} from "node:fs";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";
import { setTimeout as delay } from "node:timers/promises";
import type { Snapshot } from "../src/shared/protocol.js";
import {
  distance,
  isPassable,
  nearbyTarget,
  residents,
  speed,
  valley,
  type Point,
} from "../src/shared/world.js";
import { route } from "./paths.js";

const evidence = resolve(
  process.env.MISTSEA_EVIDENCE ?? "evidence/phase3_1",
  "cooperation",
);
const stage = (page: Page) => page.locator("#game");
const log = (page: Page) => page.getByRole("log");
const replyInput = (page: Page) => page.locator("#dialogue-input");
const playerWood = (page: Page) => page.locator("[data-item=wood]");
const npcBag = (page: Page) => page.locator("#cenyan-bag");
const ready = (page: Page) =>
  expect(stage(page)).toHaveAttribute("data-ready", "true", {
    timeout: 12_000,
  });
const activity = (page: Page, expected: string, timeout = 12_000) =>
  expect(stage(page)).toHaveAttribute("data-cenyan-activity", expected, {
    timeout,
  });

async function positions(page: Page) {
  return stage(page).evaluate((el) => ({
    player: { x: Number(el.dataset.x), y: Number(el.dataset.y) },
    cenyan: { x: Number(el.dataset.cenyanX), y: Number(el.dataset.cenyanY) },
  }));
}

async function walk(
  page: Page,
  reached: (p: Point, npc: Point) => boolean,
  repaired = false,
) {
  await stage(page).focus();
  for (let attempt = 0; attempt < 4; attempt++) {
    const { player, cenyan } = await positions(page);
    if (reached(player, cenyan)) return;
    for (const step of route(
      player,
      (point) => reached(point, cenyan),
      repaired,
      [cenyan],
    )) {
      const axis = step.axis;
      const endpoint = step[axis];
      const delta = endpoint - (await positions(page)).player[axis];
      if (Math.abs(delta) <= 2) continue;
      const sign = Math.sign(delta);
      const key = axis === "x" ? (sign > 0 ? "d" : "a") : sign > 0 ? "s" : "w";
      await page.keyboard.down(key);
      try {
        await page.waitForFunction(
          ({ axis, endpoint, sign }) =>
            (Number(document.getElementById("game")!.dataset[axis]) -
              endpoint) *
              sign >=
            -1.7,
          { axis, endpoint, sign },
          { timeout: 1600 + (Math.abs(delta) * 1000) / speed },
        );
      } catch (error) {
        if (!(error instanceof Error && error.name === "TimeoutError"))
          throw error;
        break;
      } finally {
        await page.keyboard.up(key);
      }
    }
    await expect(stage(page)).toHaveAttribute("data-moving", "false");
  }
  const { player, cenyan } = await positions(page);
  expect(
    reached(player, cenyan),
    `keyboard route ended at ${JSON.stringify({ player, cenyan })}`,
  ).toBe(true);
}

async function openChat(page: Page, moveToNpc = true) {
  if (moveToNpc)
    await walk(
      page,
      (player, npc) =>
        distance(player, npc) <= residents.get("cenyan")!.range - 5,
    );
  const { player, cenyan } = await positions(page);
  expect(distance(player, cenyan)).toBeLessThanOrEqual(
    residents.get("cenyan")!.range,
  );
  if (nearbyTarget(player, cenyan)?.id === "cenyan") {
    await stage(page).focus();
    await page.keyboard.press("e");
  } else await page.locator("#nearby-cenyan").click();
  await expect(replyInput(page)).toBeVisible();
  await expect(page.locator("#dialogue-mode")).toContainText("Mock");
}
async function say(page: Page, text: string, expected: string) {
  const rows = log(page).locator("p").filter({ hasText: expected });
  const previous = await rows.count();
  await replyInput(page).fill(text);
  await replyInput(page).press("Enter");
  await expect(rows).toHaveCount(previous + 1);
  await expect(page.locator("#dialogue-pending")).toBeHidden();
}
const closeChat = (page: Page) => page.locator("#dialogue-close").click();

