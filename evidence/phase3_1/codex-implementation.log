  }
  assert.equal(requests, 1);
  assert.equal(autonomy, 0);
  assert.equal(dialogue.status.sharedUsage?.requests, 1);
  assert.equal(storageIssue, undefined);
  assert.ok(stopped && movement > 55 && movementAfterStop > 20);
  assert.ok(minGap >= 8);
  assert.ok(samples.length >= 80);
  const sorted = [...samples].sort((a, b) => a - b);
  assert.ok(sorted[Math.ceil(sorted.length * 0.95) - 1] < tickMs, "P95 rule tick must fit the 50 ms step");
  passed = true;
} catch (error) {
  issue = error instanceof Error ? error.message : String(error);
  console.error(error);
  process.exitCode = 1;
} finally {
  world.flush();
  await dialogue.close();
  store.close();
  const sorted = samples.sort((a, b) => a - b);
  const report = {
    status: passed ? "PASS" : "FAIL", issue, pid: process.pid, elapsedMs: elapsed,
    totalMs: performance.now() - begin, requests, autonomy, maximumPending, maximumQueue, movement, movementAfterStop, stopped, minGap,
    tick: { count: sorted.length, meanMs: sorted.reduce((sum, sample) => sum + sample, 0) / sorted.length,
      p95Ms: sorted[Math.ceil(sorted.length * 0.95) - 1], maxMs: sorted.at(-1) }, trajectory,
  };
  writeFileSync(join(output, "phase31-follow-ticks.json"), JSON.stringify(report, null, 2) + "'"\\n\");
  console.log(report.status, report.elapsedMs, \"ms\", report.tick, { requests, autonomy, movement, movementAfterStop });
  rmSync(directory, { recursive: true, force: true });
}
