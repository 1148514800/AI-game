  private advanceWork(elapsed: number, now: number) {
    const next = structuredClone(this.state);
    const player = this.working && distance(next.player, bridge) <= bridge.range;
    const cenyan = this.actorWorking && distance(next.cenyan, bridge) <= bridge.range;
    if (!player) this.working = false;
