  () => ({ near: world.canTalkToCenyan(), bridge: world.publicBridge() }),
  (_, message) => events.push(message),
  {
    LLM_ENABLED: \"false\", LLM_MOCK_AUTONOMY_ENABLED: \"true\", LLM_MOCK_DELAY_MS: \"60\",
  },
  () => world.haltPlayer(),
  {
    world, active: () => true, storageError: error => { storageIssue = error; },
    mockDialogue: () => {
      requests++;
      return JSON.stringify({
        goal: \"和旅人同行\", speech: \"好，我跟着你。\", plan_policy: \"replace\",
        plan: [{ type: \"follow\", target_id: \"player\" }],
      });
    },
    mockDecision: () => {
      autonomy++;
      return JSON.stringify({ goal: \"原处等待\", speech: \"\", plan: [{ type: \"wait\", seconds: 20 }] });
    },
  },
);

const begin = performance.now();
const samples: number[] = [];
const trajectory: object[] = [];
let elapsed = 0;
let maximumPending = 0;
let maximumQueue = 0;
let minGap = Infinity;
let movement = 0;
let movementAfterStop = 0;
let stopped = false;
let passed = false;
let issue: string | undefined;

try {
  dialogue.handle(owner, { type: \"dialogue-open\", id: randomUUID(), npc: \"cenyan\" });
  const opened = events.find(event => event.event === \"opened\");
  assert.ok(opened && opened.event === \"opened\");
  const request = randomUUID();
  dialogue.handle(owner, { type: \"dialogue-send\", id: request, dialogId: opened.dialogId, text: \"我们一起去桥边吧。\" });
  const deadline = performance.now() + 2000;
  while ("'!events.some(event => event.event === "reply" && event.requestId === request) && performance.now() < deadline)
    await delay(20);
  assert.ok(events.some(event => event.event === "reply" && event.requestId === request && event.action === "accepted"));
  dialogue.handle(owner, { type: "dialogue-close", dialogId: opened.dialogId });
  const first = performance.now();
  let previousTick = first;
  let previous = world.snapshot().state.cenyan;
  let nextSample = 0;
  while (elapsed < 6500) {
    await delay(tickMs);
    const clock = performance.now();
    elapsed = clock - first;
    if (elapsed < 1050) world.setMovement({ type: "move", dx: 1, dy: 0 }, clock);
    else if (elapsed >= 2350 && elapsed < 3200) world.setMovement({ type: "move", dx: 0, dy: 1 }, clock);
    else world.setMovement({ type: "move", dx: 0, dy: 0 }, clock);
    world.tick(clock, clock - previousTick);
    dialogue.tick(clock);
    samples.push(performance.now() - clock);
    previousTick = clock;
    const { state, cenyan } = world.snapshot();
    assert.equal(state.cenyan.plan?.steps[0].type, "follow");
    assert.ok(isPassable(state.cenyan.x, state.cenyan.y, false));
    const travelled = distance(state.cenyan, previous);
    assert.ok(travelled <= speed / 20 + 0.001);
    movement += travelled;
    if (elapsed >= 2350) movementAfterStop += travelled;
    if (elapsed > 1200 && elapsed < 2300 && cenyan.activity === "waiting") stopped = true;
    previous = state.cenyan;
    minGap = Math.min(minGap, distance(state.cenyan, state.player));
    maximumPending = Math.max(maximumPending, dialogue.load.pending);
    maximumQueue = Math.max(maximumQueue, dialogue.load.queued);
    if (elapsed >= nextSample) {
      trajectory.push({
        elapsedMs: elapsed, player: state.player, cenyan: { x: state.cenyan.x, y: state.cenyan.y },
        activity: cenyan.activity, calls: dialogue.status.sharedUsage?.requests,
      });
      nextSample += 500;
