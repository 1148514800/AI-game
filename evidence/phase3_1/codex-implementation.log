    const clock = performance.now();
    const elapsed = clock - lastTick;
    lastTick = clock;
    if (!active || !world || unavailable) return;
    try {
      if (clock - lastPing >= 2000) {
        if (!answered) {
          world.halt();
          dialogue.suspend("连接已断开。", false);
          active.terminate();
          return;
        }
        if (active.readyState === WebSocket.OPEN) {
          answered = false;
          lastPing = clock;
          active.ping();
        }
      }
      if (isActive()) {
        world.tick(clock, elapsed, Date.now(), dialogue.holdsCenyan);
        dialogue.checkDistance();
        dialogue.tick(clock);
      }
      const { moving, working } = world.activity;
      if (
        moving ||
        working ||
        wasMoving ||
        wasWorking ||
        (!paused && world.cenyanActivity !== lastCenyanActivity) ||
        dialogue.status !== lastModel ||
        clock - lastSent >= 1000
      )
        update(clock);
    } catch (error) {
      storageError(error);
    } finally {
      options.observeTick?.({
        elapsedMs: elapsed,
        durationMs: performance.now() - clock,
        ...dialogue.load,
      });
    }
  }, tickMs);
  timer.unref();

  app.server.on("upgrade", (request, socket, head) => {
    const origin = request.headers.origin;
    const host = request.headers.host ?? "";
    const isLoopback = /^(127\.0\.0\.1|localhost|\[::1\])(:\d+)?$/i.test(host);
    const sameOrigin =
      !origin || origin === `http://${host}` || origin === `https://${host}`;
    if (request.url !== "/ws" || !isLoopback || !sameOrigin) {
      socket.destroy();
      return;
    }
    ws.handleUpgrade(request, socket, head, (client) =>
      ws.emit("connection", client, request),
    );
  });

  ws.on("connection", (socket) => {
    socket.on("error", () => socket.terminate());
    if (!world || unavailable) {
      send(socket, {
        type: "error",
        code: "SAVE_ERROR",
        text: unavailable ?? "存档不可用。",
      });
      socket.close(1011);
      return;
    }
    const current = world;
    if (active) {
      dialogue.suspend("另一标签页已接管旅程。", false);
      active.close(4001, "single player");
    }
    current.halt();
    active = socket;
    paused = false;
    lastPing = performance.now();
    dialogue.resume(lastPing);
    answered = true;
    socket.on("pong", () => {
      if (active === socket) answered = true;
    });
    let inputWindow = lastPing;
    let messages = 0;
    let actions = 0;

    socket.on("message", (raw, binary) => {
      if (active !== socket || unavailable) return;
      const clock = performance.now();
      if (clock - inputWindow >= 1000) {
        inputWindow = clock;
        messages = 0;
        actions = 0;
      }
      if (++messages > 90) {
        socket.close(1008, "input limit");
        return;
      }

      let input: unknown;
      try {
        input = binary ? null : JSON.parse(raw.toString());
      } catch {
        input = null;
      }
      const parsed = clientMessage.safeParse(input);
      if (!parsed.success) {
        send(socket, {
          type: "error",
          code: "INVALID_MESSAGE",
          text: "行动格式无效。",
        });
        return;
      }

      const message = parsed.data;
      if (
        message.type === "dialogue-open" ||
        message.type === "dialogue-send" ||
        message.type === "dialogue-close"
      ) {
        try {
          dialogue.handle(socket, message);
        } catch {
          console.warn("[dialogue] internal");
          if (message.type !== "dialogue-close")
            send(socket, {
              type: "dialogue",
              event: "error",
              requestId: message.id,
              dialogId:
                message.type === "dialogue-send" ? message.dialogId : undefined,
              code: "internal",
              text: "暂时无法处理对话，可手动重试。",
            });
        }
        return;
      }

      try {
        switch (message.type) {
          case "move":
            if (!paused) current.setMovement(message, clock);
            break;
          case "pause":
            if (paused !== message.paused) {
              paused = message.paused;
              if (paused) {
                dialogue.suspend("旅程已暂停。");
                current.halt();
                current.flush();
              } else dialogue.resume(clock);
            }
            update(clock);
            break;
          case "action":
          case "reset": {
            if (++actions > 8 || (paused && message.type === "action")) {
              send(socket, {
                type: "result",
                id: message.id,
                ok: false,
                code: paused ? "PAUSED" : "RATE_LIMIT",
                text: paused ? "请先继续游玩。" : "操作太快，请稍等。",
              });
              break;
            }
            const result =
              message.type === "reset"
                ? current.reset(message)
                : current.perform(message);
            if (message.type === "reset" && result.ok) dialogue.reset();
            update(clock);
            send(socket, result);
            break;
          }
        }
      } catch (error) {
        storageError(error);
      }
    });

    socket.on("close", () => {
      if (active !== socket) return;
      active = undefined;
      dialogue.suspend("连接已断开。", false);
      current.halt();
      if (!unavailable) {
        try {
          current.flush();
        } catch (error) {
          storageError(error);
        }
      }
    });
    update();
  });

  app.addHook("preClose", async () => {
    clearInterval(timer);
    dialogue.suspend("服务正在关闭。", false);
    for (const socket of ws.clients) socket.terminate();
    active = undefined;
    if (!unavailable) {
      try {
        world?.flush();
      } catch (error) {
        storageError(error);
      }
    }
    ws.close();
  });
  app.addHook("onClose", async () => {
    await dialogue.close();
    save?.close();
  });
  return app;
}
import {
  distance,
  isPassable,
  mapHeight,
  mapWidth,
  type Point,
  type Target,
} from "../shared/world.js";

const stride = 8;
const offsets = [
  { x: stride, y: 0 },
  { x: -stride, y: 0 },
  { x: 0, y: stride },
  { x: 0, y: -stride },
];
type Node = Point & { cost: number; score: number; previous?: Node };

function push(queue: Node[], node: Node) {
  let index = queue.length;
  queue.push(node);
  while (index > 0) {
    const parent = (index - 1) >> 1;
    if (queue[parent].score <= node.score) break;
    queue[index] = queue[parent];
    index = parent;
  }
  queue[index] = node;
}

function pop(queue: Node[]): Node {
  const first = queue[0];
  const tail = queue.pop()!;
  if (!queue.length) return first;
  let index = 0;
  while (index * 2 + 1 < queue.length) {
    let child = index * 2 + 1;
    if (child + 1 < queue.length && queue[child + 1].score < queue[child].score)
      child++;
    if (queue[child].score >= tail.score) break;
    queue[index] = queue[child];
    index = child;
  }
  queue[index] = tail;
  return first;
}

/** A* over eight-pixel cardinal edges, including their intermediate clearance. */
export function findPath(
  start: Point,
  target: Target,
  repaired: boolean,
  occupants: Point[] = [],
): Point[] | undefined {
  const columns = Math.ceil(mapWidth / stride) + 1;
  const rows = Math.ceil(mapHeight / stride) + 1;
  const cost = new Float64Array(columns * rows).fill(Infinity);
  const key = (p: Point) =>
    Math.floor(p.x / stride) + Math.floor(p.y / stride) * columns;
  const heuristic = (p: Point) =>
    Math.max(0, distance(p, target) - target.range);
  const clear = (p: Point, from: Point) =>
    isPassable(p.x, p.y, repaired) &&
    occupants.every((other) => canApproach(from, p, other));
  const queue: Node[] = [
    { x: start.x, y: start.y, cost: 0, score: heuristic(start) },
  ];
  cost[key(start)] = 0;
  while (queue.length) {
    const current = pop(queue);
    if (current.cost !== cost[key(current)]) continue;
    if (heuristic(current) === 0) {
      const points: Point[] = [];
      for (let path = current; path.previous; path = path.previous)
        points.push({ x: path.x, y: path.y });
      return points.reverse();
    }
    for (const { x: dx, y: dy } of offsets) {
      const point = { x: current.x + dx, y: current.y + dy };
      const nextCost = current.cost + stride;
      const index = key(point);
      if (!clear(point, current) || nextCost >= cost[index]) continue;
      if (!clear({ x: current.x + dx / 2, y: current.y + dy / 2 }, current))
        continue;
      cost[index] = nextCost;
      push(queue, {
        ...point,
        cost: nextCost,
        score: nextCost + heuristic(point),
        previous: current,
      });
    }
  }
}

/** An overlapping actor can leave (including when a legacy save loads). */
export function canApproach(from: Point, to: Point, other: Point) {
  const gap = distance(to, other);
  return gap >= 8 || gap > distance(from, other);
}
