const waitFor = async <T>(read: () => T | undefined, label: string, timeout = 4500) => {
  const deadline = performance.now() + timeout;
  while (performance.now() < deadline) {
    const value = read();
    if (value "'!== undefined) return value;
    await delay(15);
  }
  throw Error(`Timed out waiting for ${label}`);
};
const id = randomUUID;

test("Phase3.1 real local HTTP and WS authenticate each direction of consent, reject a wrong offer and replay one commit", { timeout: 40_000 }, async (t) => {
  const dir = mkdtempSync(join(tmpdir(), "mistsea-phase31-http-"));
  const evidence = process.env.MISTSEA_EVIDENCE ?? "evidence/phase3_1";
  mkdirSync(evidence, { recursive: true });
