          : "桥板断裂，河水截断了去东岸的路。";
        nextSelection = {
          target: bridge.id,
          verb: "inspect",
          label: "查看旧桥",
        };
      } else if (!hasMaterials) {
        hint = `交付木材 ×${bridge.required.wood - built.wood}、石材 ×${bridge.required.stone - built.stone}。`;
        nextSelection = {
          target: bridge.id,
          verb: "deliver",
          label: "交付材料",
        };
      } else if (snapshot.cenyan.activity === "working") {
        hint = "岑砚正在施工，请给他腾出工地。";
        nextSelection = {
          target: bridge.id,
          verb: "inspect",
          label: "查看旧桥",
        };
      } else if (working) {
        hint = "留在渡口完成施工，走动会暂停。";
        nextSelection = { target: bridge.id, verb: "stop", label: "暂停施工" };
      } else {
        hint = "材料已就位，按 E 开始施工。";
        nextSelection = { target: bridge.id, verb: "work", label: "开始施工" };
      }
    } else {
      image = "letter";
      hint = "石面刻着磨损的星纹。";
      nextSelection = { target: target.id, verb: "inspect", label: "查看航标" };
    }
  }
  const changed = target?.id !== lastTarget;
  const actionChanged = nextSelection?.verb !== lastVerb;
  if (changed) shownResult = false;
  if (changed || actionChanged || !renderedSelection) {
    renderedSelection = true;
    targetName.textContent = target?.name ?? "探索雾灯谷";
    if (target) {
      feedbackIcon.src = `/assets/${image}.png`;
      feedbackIcon.hidden = false;
    } else feedbackIcon.hidden = true;
    primary.replaceChildren(
      document.createTextNode((nextSelection?.label ?? "附近无交互") + " "),
      label("E", "kbd"),
    );
    inspect.hidden =
      target?.id !== bridge.id || nextSelection?.verb === "inspect";
  }
  if (!shownResult && (changed || hint !== lastHint))
    feedback.textContent = hint;
  lastTarget = target?.id;
  lastVerb = nextSelection?.verb;
  lastHint = hint;
  selection = nextSelection;
  enableActions(enabled);
}
});

function request(
  message: Omit<Action, "id"> | { type: "reset"; confirm: true },
) {
  if (!online() || pending) return;
  const id = crypto.randomUUID();
  if (!connection.send({ ...message, id })) return;
  pending = {
    id,
    timer: window.setTimeout(() => {
      clearPending();
      updateControls();
      showFeedback("还没收到行动回执。请查看存档状态后再试。");
    }, 3500),
  };
  updateControls();
}

function interact() {
  const action = selectedAction();
  if (!canPlay() || !action) return;
  if (action.target === "cenyan") dialogue.open();
  else request({ type: "action", target: action.target, verb: action.verb });
}

function setPaused(active: boolean) {
  if (!online() || paused === active) return;
  paused = active;
  if (active) dialogue.close();
  input.clear();
  connection.send({ type: "pause", paused });
  updateControls();
}

const input = bindInput({
  canMove: canPlay,
  send: (message: ClientMessage) =>
    service.kind === "online" && connection.send(message),
  interact,
  pause: () => setPaused(!paused),
  blurred: () => setPaused(true),
});

const dialogue = bindDialogue({
  send: (message) => connection.send(message),
  feedback: showFeedback,
  changed() {
    input.clear();
    updateControls();
  },
});

retry.addEventListener("click", () => void connection.connect());
pause.addEventListener("click", () => setPaused(!paused));
element("interact").addEventListener("click", interact);
element("bridge-check").addEventListener("click", () => {
  if (canPlay() && selectedAction()?.target === valley.bridge.id)
    request({ type: "action", target: valley.bridge.id, verb: "inspect" });
});
overview.addEventListener("click", () => {
  showingOverview = !showingOverview;
  overview.setAttribute("aria-pressed", String(showingOverview));
  overview.textContent = showingOverview ? "返回场景" : "全谷地图";
  scene.setOverview(showingOverview);
});
reset.addEventListener("click", () => {
  dialogue.close();
  resetDialog.returnValue = "";
  input.clear();
  resetDialog.showModal();
});
resetDialog.addEventListener("close", () => {
  if (resetDialog.returnValue === "reset")
    request({ type: "reset", confirm: true });
  updateControls();
}

test("planner schemas accept one through three steps and accept speech-only refusals", () => {
  const step = { type: "collect", target_id: node.id };
  const base = { goal: "stock-wood", speech: "先找木料。" };
  for (const count of [1, 2, 3])
    assert.ok(
      decisionSchema.safeParse({ ...base, plan: Array(count).fill(step) })
        .success,
    );
  assert.ok(actionReplySchema.safeParse(base).success);
  for (const count of [0, 4])
    assert.equal(
      decisionSchema.safeParse({ ...base, plan: Array(count).fill(step) })
        .success,
      false,
    );
});

test("planner schemas reject arbitrary locations, unknown IDs, tools, extras and out-of-range waits", () => {
  const base = { goal: "stock-wood", speech: "" };
  for (const step of [
    { type: "move_to", x: 5, y: 10, target_id: home.id },
    { type: "collect", target_id: bridge.id },
    { type: "work", target_id: node.id },
    { type: "move_to", target_id: "imaginary-place" },
    { type: "sql", query: "x" },
    { type: "wait", seconds: 31 },
    { type: "rest", seconds: 0.1 },
  ])
    assert.equal(
      decisionSchema.safeParse({ ...base, plan: [step] }).success,
      false,
    );
  assert.equal(
    decisionSchema.safeParse({
      ...base,
      plan: [{ type: "wait", seconds: 1 }],
      reasoning: "x",
    }).success,
    false,
  assert.equal(world.snapshot().state.cenyan.bag.wood, 1);
});

test("NPC delivery, shared work lock and progress survive interruption without double spending", (t) => {
  const { world, tick, accept, path, now } = setup(t, (state) => {
    Object.assign(state.cenyan, { x: bridge.x - 15, y: bridge.y });
    state.player = { x: bridge.x - 24, y: bridge.y + 10, facing: "right" };
    state.cenyan.bag = { wood: 6, stone: 2 };
  });
  accept(
    { type: "deliver", target_id: bridge.id },
    { type: "work", target_id: bridge.id },
  );
  tick(18);
  assert.equal(world.snapshot().state.bridge.wood, 6);
  assert.ok(world.snapshot().state.bridge.progressMs > 0);
  assert.equal(
    world.perform(action("work", bridge.id), now()).code,
    "WORK_OCCUPIED",
  );
  world.halt();
  world.flush();
  const restored = new SaveFile(path);
  try {
    const resumed = new World(restored);
    assert.equal(resumed.snapshot().state.cenyan.plan?.index, 1);
    assert.deepEqual(resumed.snapshot().state.cenyan.bag, {
      wood: 0,
      stone: 0,
    });
    const progress = resumed.snapshot().state.bridge.progressMs;
    assert.ok(progress < bridge.workMs);
    for (let i = 0; i < bridge.workMs / 50 - 1; i++)
      resumed.tick(i * 50, 50, now());
    assert.equal(resumed.snapshot().state.bridge.repaired, true);
    assert.equal(resumed.snapshot().state.cenyan.plan, null);
    assert.equal(resumed.snapshot().state.inventory.wood, 0);
    assert.equal(
      restored
        .memories(bridge.id, 20)
        .filter((m) => m.content.startsWith("材料已放")).length,
      1,
    );
  } finally {
    restored.close();
  }
});

