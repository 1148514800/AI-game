    const permittedPlan =
      reply.plan &&
      (claim !== undefined ||
        !reply.plan.some((step) => step.type === "follow"));
    if (
      reply.plan &&
      permittedPlan &&
      (policy === "replace" || policy === "defer")
    ) {
      const proposed = {
        id,
        goal: reply.goal,
        ...(reply.goal_tag && { goalTag: reply.goal_tag }),
        steps: reply.plan,
      };
      if (policy === "defer" && actor.plan) {
        if (!actor.pending) {
          actor.pending = proposed;
          actor.generation++;
          status = "deferred";
        }
      } else {
