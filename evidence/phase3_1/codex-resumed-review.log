        if (!proposal && !gift) world?.rememberExchange(msg.id, player, speech);
        if (proposal && world) this.focusedTopic = world.topic(player);
        this.history.push({ player, reply: speech });
        if (this.history.length > historyTurns) this.history.shift();
        this.send(owner, {
          type: "dialogue",
          event: "reply",
          requestId: msg.id,
          dialogId: dialog.id,
          text: speech,
          action: resolution,
          gift: giftResult,
        });
      },
    };
    if (this.pending) {
      this.queued = job;
      this.pending.abort.abort();
      this.send(owner, {
        type: "dialogue",
        event: "pending",
        requestId: msg.id,
        dialogId: dialog.id,
      });
    } else {
      this.start(job, () =>
        this.send(owner, {
          type: "dialogue",
          event: "pending",
          requestId: msg.id,
          dialogId: dialog.id,
