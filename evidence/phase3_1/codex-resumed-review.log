            text: "当前行动已被新计划替换，已完成的成果保留。",
          });
        actor.pending = null;
        actor.generation++;
        this.activatePlan(next, proposed, now, records);
        status = "accepted";
      }
    }
    actor.decision = {
      id,
      policy,
      goal: reply.goal,
      status,
      ...(reply.goal_tag && { goalTag: reply.goal_tag }),
      ...(reply.plan && { steps: reply.plan }),
    };
    this.commit(next, receipt, records);
    if (status === "accepted") {
      this.haltCenyan();
      this.trigger("goal-changed");
    }
    return status;
  }

