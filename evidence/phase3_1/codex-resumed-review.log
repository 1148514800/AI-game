      session.handle(owner, { type: \"dialogue-send\", id: requestId, dialogId, text });
      await settled();
      assert.ok(messages.some(event => event.event === \"error\" && event.requestId === requestId && event.code === \"invalid\"));
      assert.equal(state().cenyan.decision?.id, id);
    }
    assert.doesNotMatch(JSON.stringify({ messages, state: state() }), /phase31-redaction-dummy|PRIVATE_REASONING|不可见/);
  } finally { await session.close(); }
});
