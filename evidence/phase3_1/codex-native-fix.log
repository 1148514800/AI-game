python3 - <<'PY'
from datetime import datetime, timedelta, timezone
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

evidence = Path(\"evidence/phase3_1\")
output = Path(tempfile.mkdtemp(prefix=\"keyboard-route-fix-\", dir=evidence))
env = {name: os.environ[name] for name in (\"PATH\", \"HOME\", \"TMPDIR\", \"TMP\", \"TEMP\", \"LANG\", \"LC_ALL\") if name in os.environ}
env.update(LLM_ENABLED=\"false\", LLM_AUTONOMY_ENABLED=\"false\", LLM_MOCK_AUTONOMY_ENABLED=\"false\", MISTSEA_EVIDENCE=str(output))
commands = [
    ([\"npm\", \"run\", \"typecheck\"], \"typecheck.log\"),
    ([\"npm\", \"test\"], \"unit-test.log\"),
    ([\"git\", \"diff\", \"--check\"], \"diff-check.log\"),
]
results = []
for args, name in commands:
    started = datetime.now(timezone(timedelta(hours=8))).isoformat()
    path = output / name
    with path.open(\"w\") as stream:
        code = subprocess.run(args, env=env, stdout=stream, stderr=subprocess.STDOUT, check=False).returncode
