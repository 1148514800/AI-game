import {distance,isPassable,valley} from './src/shared/world.ts';
import {randomUUID} from 'node:crypto';
const cenyan={x:338.2776,y:494.0182}, target={x:399,y:449};
const reached=q=>distance(q,target)<=14;
for(const player of [{x:337.4662,y:471.6158},{x:335.5,y:471.8},{x:336.15,y:480.05}]){
 const steps=findKeyboardRoute(player,reached,false,[cenyan]);
 console.log({player,steps,forbiddenCrossing:"'!!findKeyboardRoute(player,q=>distance(q,valley.ruin)<20,false,[cenyan])});
 if(!steps) continue;
 const save=new SaveFile('"':memory:');
 const state=structuredClone(save.initial);
 Object.assign(state.player,player);
 Object.assign(state.cenyan,cenyan);
 // Start the simulation from the game positions under test.
 save.write(state);
 const world=new World({ ...save, initial:state, memories:save.memories.bind(save), hasReceipt:save.hasReceipt.bind(save), write:save.write.bind(save) });
 let clock=0;
 const movement=(dx,dy)=>{clock+=50;world.setMovement({type:'move',dx,dy},clock);world.tick(clock,50,1000000+clock);};
 world.accept(randomUUID(),{goal:'一起去桥边',speech:'好',plan:[{type:'follow',target_id:'player'}]},1_000_000,'一起去桥边');
 const pose=()=>world.snapshot().state;
 for (const step of steps){
   const sign=step[step.axis]>pose().player[step.axis]?1:-1;
   for(let i=0;i<40&&(step[step.axis]-pose().player[step.axis])*sign>1.7;i++)movement(step.axis==='x'?sign:0,step.axis==='y'?sign:0);
   movement(0,0);
 }
 console.log('simulated',reached(pose().player),pose().player,pose().cenyan.last?.code);
 save.close();
}
