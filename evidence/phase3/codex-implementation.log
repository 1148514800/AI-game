test(\"local HTTP fixture validates a dialogue plan once, cancels one before acceptance and remembers actual execution across a real service restart\", { timeout: 25_000 }, async (t) => {
  const resource = valley.resources[2];
  const calls: ProviderBody[] = [];
  const aborted: number[] = [];
  const env = await localProvider(t, (_request, response, body) => {
    const index = calls.push(body) - 1;
    const payload = textReply(JSON.stringify({ goal: \"stock-wood\", speech: \"我先去找木料。\",
      plan: [{ type: \"move_to\", target_id: resource.id }, { type: \"collect\", target_id: resource.id }],
    }), { prompt_tokens: 60, completion_tokens: 50 });
    if (index === 0) {
      const timer = setTimeout(() => response.end(payload), 1200);
      response.on(\"close\", () => {
        clearTimeout(timer);
        if ("'!response.writableEnded) aborted.push(index);
      });
    } else response.end(payload);
  });
  const dir = mkdtempSync(join(tmpdir(), "mistsea-phase3-action-http-"));
  const savePath = join(dir, "world.sqlite");
  let app: ReturnType<typeof createApp>;
  async function start() {
    app = createApp({ savePath, dialogueEnv: { ...env, LLM_AUTONOMY_ENABLED: "false" } });
    return app.listen({ port: 0, host: "127.0.0.1" });
  }
  t.after(async () => {
    await app?.close();
    rmSync(dir, { recursive: true, force: true });
  });
  let url = await start();
  let player = await connect(url);
  await nearCenyan(player);
  let dialog = await opened(player);
  const stale = submit(player, dialog, "请你帮我采木。");
  await waitFor(() => calls[0], "first local HTTP action request");
  player.send({ type: "dialogue-close", dialogId: dialog });
  await waitFor(() => aborted.length || undefined, "upstream abort");
  assert.equal(player.state().state.cenyan.plan, null);
  assert.ok(!player.events.some((e) => e.type === "dialogue" && e.event === "reply" && e.requestId === stale.id));

  dialog = await opened(player);
  const active = submit(player, dialog, "请你帮我采木。");
  const accepted = await player.dialogue("reply", (e) => e.requestId === active.id);
  assert.equal(accepted.action, "accepted");
  player.send({ type: "dialogue-close", dialogId: dialog });
  await waitFor(() => player.state().state.cenyan.bag.wood === 1 || undefined, "Cenyan harvested");
  const result = player.state();
  assert.equal(result.state.inventory.wood, 0);
  assert.ok(result.state.cooldowns[resource.id] > result.now);
  assert.ok(calls[1].messages[0].content.includes(resource.id));
  assert.ok(calls[1].messages[0].content.includes("附近人物"));
  assert.equal(calls.length, 2, "same-request plan and speech");

  await app!.close();
  url = await start();
  player = await connect(url);
  const restarted = player.state();
  assert.deepEqual(restarted.state.cenyan, result.state.cenyan);
  assert.deepEqual(restarted.cenyan.memory, result.cenyan.memory);
  assert.ok(restarted.cenyan.memory.some((m) => m.kind === "claim" && m.event === active.id));
  assert.ok(restarted.cenyan.memory.some((m) => m.kind === "fact" && m.event.includes(active.id) && /获得 木材/.test(m.content)));
});

