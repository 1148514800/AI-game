import Phaser from "phaser";
import "./style.css";
import { Connection, type ConnectionStatus } from "./connection.js";
import { bindDialogue } from "./dialogue.js";
import { bindInput } from "./input.js";
import { ValleyScene } from "./scene.js";
import {
  element,
  enableActions,
  furnishJournal,
  render,
  selectedAction,
  setText,
  showFeedback,
  showFinished,
  showResult,
} from "./ui.js";
import type { Action, ClientMessage, Snapshot } from "../shared/protocol.js";
import { valley } from "../shared/world.js";

furnishJournal();
const stage = element("game");
const screen = element("screen-message");
const connectionLabel = element("connection");
const retry = element<HTMLButtonElement>("retry");
const music = element<HTMLButtonElement>("music");
const pause = element<HTMLButtonElement>("pause");
const overview = element<HTMLButtonElement>("overview");
const reset = element<HTMLButtonElement>("reset");
const resetDialog = element<HTMLDialogElement>("reset-dialog");
const sound = element<HTMLButtonElement>("sound");

let assetState: "loading" | "ready" | "failed" = "loading";
let failures: string[] = [];
let service: ConnectionStatus = {
  kind: "connecting",
  detail: "正在读取存档。",
};
let snapshot: Snapshot | undefined;
let paused = false;
let soundEnabled = true;
let showingOverview = false;
let pending: { id: string; timer: number } | undefined;

function online() {
  return (
    assetState === "ready" && service.kind === "online" && Boolean(snapshot)
  );
}

function canPlay() {
  return online() && !paused && !resetDialog.open && !dialogue.active();
}

function updateControls() {
  const connected = online();
  const ready = String(connected);
  if (stage.dataset.ready !== ready) stage.dataset.ready = ready;
  scene.setHalted(!connected || paused || resetDialog.open);
  const state =
    assetState === "failed" || service.kind === "failed"
      ? "error"
      : connected
        ? "online"
        : service.kind;
  if (connectionLabel.dataset.state !== state)
    connectionLabel.dataset.state = state;
  setText(
    connectionLabel,
    assetState === "failed"
      ? "素材缺失"
      : connected
        ? "本地存档已连接"
        : {
            online: "正在读取素材",
            connecting: "正在连接",
            retrying: "重连中",
            failed: "服务不可用",
            occupied: "旅程已切换",
          }[service.kind],
  );
  if (pause.disabled === connected) pause.disabled = !connected;
  setText(pause, paused ? "继续" : "暂停");
  if (pause.getAttribute("aria-pressed") !== String(paused))
    pause.setAttribute("aria-pressed", String(paused));
  if (overview.disabled === connected) overview.disabled = !connected;
  const disableReset = !connected || Boolean(pending);
  if (reset.disabled !== disableReset) reset.disabled = disableReset;
  if (music.disabled === (assetState === "ready"))
    music.disabled = assetState !== "ready";
  setText(element("save-status"), connected ? "本地自动存档" : "等待本地存档");
  if (snapshot) render(snapshot, canPlay() && !pending);
  else enableActions(false);

  const hideScreen = connected && !paused;
  if (screen.hidden !== hideScreen) screen.hidden = hideScreen;
  if (screen.hidden) return;
  retry.hidden = true;
  let title = "正在进入雾灯谷";
  let detail = "正在读取本地素材和存档。";
  if (assetState === "failed") {
    title = "游戏素材加载失败";
    detail = `无法读取 ${failures.join("、")}。请检查本地文件后重新加载页面。`;
  } else if (service.kind !== "online") {
    title =
      service.kind === "retrying"
        ? "正在重连雾灯谷"
        : service.kind === "failed" || service.kind === "occupied"
          ? "暂时无法进入雾灯谷"
          : "正在连接雾灯谷";
    detail = service.detail;
    retry.hidden = service.kind === "connecting";
  } else if (paused) {
    title = "旅程暂停";
    detail = "按 Esc 或点击「继续」回到雾灯谷。";
  }
  setText(element("screen-title"), title);
  setText(element("screen-detail"), detail);
}

const scene = new ValleyScene((missing) => {
  failures = missing;
  assetState = missing.length ? "failed" : "ready";
  updateControls();
});

function clearPending() {
  if (pending) clearTimeout(pending.timer);
  pending = undefined;
}

const connection = new Connection({
  status(status) {
    service = status;
    if (status.kind !== "online") {
      dialogue.close(false);
      snapshot = undefined;
      clearPending();
      input.clear();
    } else if (paused) {
      connection.send({ type: "pause", paused: true });
    }
    updateControls();
  },
  snapshot(next) {
    const completed =
      snapshot && !snapshot.state.bridge.repaired && next.state.bridge.repaired;
    snapshot = next;
    scene.apply(next);
    updateControls();
    if (completed) {
      showFinished();
      if (soundEnabled && assetState === "ready") scene.playSound();
    }
  },
  result(result) {
    if (pending?.id !== result.id) return;
    clearPending();
    updateControls();
    showResult(result);
    if (result.ok && soundEnabled && assetState === "ready") scene.playSound();
  },
  dialogue(event) {
    dialogue.receive(event);
  },
  error: showFeedback,
});

function request(
  message: Omit<Action, "id"> | { type: "reset"; confirm: true },
) {
  if (!online() || pending) return;
  const id = crypto.randomUUID();
  if (!connection.send({ ...message, id })) return;
  pending = {
    id,
    timer: window.setTimeout(() => {
      clearPending();
      updateControls();
      showFeedback("还没收到行动回执。请查看存档状态后再试。");
    }, 3500),
  };
  updateControls();
}

function interact() {
  const action = selectedAction();
  if (!canPlay() || !action) return;
  if (action.target === "cenyan") dialogue.open();
  else request({ type: "action", target: action.target, verb: action.verb });
}

function setPaused(active: boolean) {
  if (!online() || paused === active) return;
  paused = active;
  if (active) dialogue.close();
  input.clear();
  connection.send({ type: "pause", paused });
  updateControls();
}

const input = bindInput({
  canMove: canPlay,
  send: (message: ClientMessage) =>
    service.kind === "online" && connection.send(message),
  interact,
  pause: () => setPaused(!paused),
  blurred: () => setPaused(true),
});

const dialogue = bindDialogue({
  send: (message) => connection.send(message),
  feedback: showFeedback,
  changed() {
    input.clear();
    updateControls();
  },
});

retry.addEventListener("click", () => void connection.connect());
pause.addEventListener("click", () => setPaused(!paused));
element("interact").addEventListener("click", interact);
element("bridge-check").addEventListener("click", () => {
  if (canPlay() && selectedAction()?.target === valley.bridge.id)
    request({ type: "action", target: valley.bridge.id, verb: "inspect" });
});
overview.addEventListener("click", () => {
  showingOverview = !showingOverview;
  overview.setAttribute("aria-pressed", String(showingOverview));
  overview.textContent = showingOverview ? "返回场景" : "全谷地图";
  scene.setOverview(showingOverview);
});
reset.addEventListener("click", () => {
  dialogue.close();
  resetDialog.returnValue = "";
  input.clear();
  resetDialog.showModal();
});
resetDialog.addEventListener("close", () => {
  if (resetDialog.returnValue === "reset")
    request({ type: "reset", confirm: true });
  updateControls();
});
music.addEventListener("click", async () => {
  try {
    const active = await scene.toggleMusic();
    music.setAttribute("aria-pressed", String(active));
    music.textContent = active ? "音乐开" : "音乐关";
  } catch {
    showFeedback("环境音乐启动失败，可以再次点击重试。");
  }
});
sound.addEventListener("click", () => {
  soundEnabled = !soundEnabled;
  sound.setAttribute("aria-pressed", String(soundEnabled));
  sound.textContent = soundEnabled ? "音效开" : "音效关";
});

new Phaser.Game({
  type: Phaser.CANVAS,
  scale: { mode: Phaser.Scale.NONE, width: 428, height: 282 },
  parent: stage,
  pixelArt: true,
  roundPixels: true,
  antialias: false,
  backgroundColor: "#283c32",
  scene,
  banner: false,
});
void connection.connect();
import Phaser from "phaser";
import animations from "../../data/animations.json";
import manifest from "../../assets/manifest.json";
import type { Snapshot } from "../shared/protocol.js";
import {
  distance,
  mapHeight,
  mapWidth,
  nearbyTarget,
  valley,
  type Direction,
} from "../shared/world.js";

const spritesheets = new Set([
  "player-walk",
  "player-idle",
  ...valley.residents.map((actor) => `${actor.asset}-idle`),
]);
const variants = new Map(valley.resources.map((entry) => [entry.id, entry]));

export class ValleyScene extends Phaser.Scene {
  private player?: Phaser.GameObjects.Sprite;
  private shadow?: Phaser.GameObjects.Ellipse;
  private marker?: Phaser.GameObjects.Image;
  private bridge?: Phaser.GameObjects.Image;
  private nodeSprites = new Map<string, Phaser.GameObjects.Image>();
  private failed: string[] = [];
  private current?: Snapshot;
  private overview = false;
  private halted = true;
  private view?: HTMLElement;
  private music?: Phaser.Sound.BaseSound;
  private markerTarget?: ReturnType<typeof nearbyTarget>;
  private markerPlayer?: Snapshot["state"]["player"];

  constructor(private readonly onAssets: (failures: string[]) => void) {
    super("foglamp-valley");
  }

  preload() {
    this.load.on("loaderror", (file: { key: string }) =>
      this.failed.push(file.key),
    );
    const uses = new Set([
      "valley-ground",
      "valley-river",
      "bridge-broken",
      "bridge-open",
      "player-face",
      "wood",
      "stone",
      "food",
      "toolbox",
      "letter",
      "arrow",
      "village",
      "alert",
      ...spritesheets,
      ...valley.props.map((object) => object.asset),
      ...valley.residents.map((resident) => `${resident.asset}-face`),
      ...valley.resources.flatMap((resource) => [
        resource.asset,
        resource.spent,
      ]),
    ]);
    for (const { assetId } of manifest.assets) {
      const key = assetId.replace(/\.[^.]+$/, "");
      if (!uses.delete(key)) continue;
      const path = `/assets/${assetId}`;
      if (spritesheets.has(key)) {
        this.load.spritesheet(key, path, {
          frameWidth: animations.frameWidth,
          frameHeight: animations.frameHeight,
        });
      } else if (assetId.endsWith(".png")) {
        this.load.image(key, path);
      } else {
        this.load.audio(key, path);
      }
    }
    this.failed.push(...uses);
  }

  create() {
    this.view = document.querySelector<HTMLElement>("#game")!;
    const size = new ResizeObserver(() => this.resizeView());
    size.observe(this.view);
    this.events.once("shutdown", () => size.disconnect());
    this.resizeView();
    if (this.failed.length) {
      this.onAssets(this.failed);
      return;
    }

    this.drawTerrain();
    const { left, top } = valley.bridge;
    this.bridge = this.add
      .image(left, top, "bridge-broken")
      .setOrigin(0)
      .setDepth(-500);
    for (const prop of valley.props) {
      this.add
        .image(prop.x, prop.y, prop.asset)
        .setOrigin(0.5, 1)
        .setDepth(prop.ground ? -800 : prop.y);
    }
    for (const resource of valley.resources) {
      this.nodeSprites.set(
        resource.id,
        this.add
          .image(resource.x, resource.y, resource.asset)
          .setOrigin(0.5, 1)
          .setDepth(resource.y),
      );
      const label = resource.item === "wood" ? "wood" : "stone";
      this.add
        .image(resource.x, resource.y - 21, label)
        .setOrigin(0.5)
        .setDepth(850)
        .setScale(0.7);
    }
    for (const resident of valley.residents) {
      this.drawShadow(resident.x, resident.y);
      this.add
        .sprite(
          resident.x,
          resident.y,
          `${resident.asset}-idle`,
          animations.directionColumns[resident.facing],
        )
        .setOrigin(0.5, 1)
        .setDepth(resident.y);
      this.nameplate(resident.x, resident.y, resident.name);
    }
    for (const direction of Object.keys(
      animations.walk.framesByDirection,
    ) as Direction[]) {
      this.anims.create({
        key: `walk-${direction}`,
        frames: animations.walk.framesByDirection[direction].map((frame) => ({
          key: "player-walk",
          frame,
        })),
        frameRate: animations.walk.frameRate,
        repeat: -1,
      });
    }
    const start = this.current?.state.player ?? valley.spawn;
    this.shadow = this.drawShadow(start.x, start.y);
    this.player = this.add
      .sprite(start.x, start.y, "player-idle", 0)
      .setOrigin(0.5, 1)
      .setDepth(start.y);
    this.marker = this.add
      .image(0, 0, "arrow")
      .setOrigin(0.5, 1)
      .setDepth(990)
      .setVisible(false);
    this.setOverview(this.overview);
    if (this.current) this.apply(this.current);
    this.onAssets([]);
  }

  setOverview(active: boolean) {
    this.overview = active;
    if (!this.player) return;
    const camera = this.cameras.main;
    if (active) {
      camera.stopFollow();
      camera.removeBounds();
      camera.setZoom(
        Math.min(camera.width / mapWidth, camera.height / mapHeight) * 0.98,
      );
      camera.centerOn(mapWidth / 2, mapHeight / 2);
    } else {
      camera.setZoom(1);
      camera.setBounds(0, 0, mapWidth, mapHeight);
      camera.startFollow(this.player, true);
    }
  }

  setHalted(value: boolean) {
    this.halted = value;
  }

  apply(snapshot: Snapshot) {
    const player = this.player;
    this.current = snapshot;
    if (!player || !this.view) return;
    this.setDebug("x", snapshot.state.player.x.toFixed(4));
    this.setDebug("y", snapshot.state.player.y.toFixed(4));
    if (distance(player, snapshot.state.player) > 48)
      player.setPosition(snapshot.state.player.x, snapshot.state.player.y);
    const bridgeTexture = snapshot.state.bridge.repaired
      ? "bridge-open"
      : "bridge-broken";
    if (this.bridge && this.bridge.texture.key !== bridgeTexture)
      this.bridge.setTexture(bridgeTexture);
    for (const [id, node] of this.nodeSprites) {
      const resource = variants.get(id)!;
      const spent = (snapshot.state.cooldowns[id] ?? 0) > snapshot.now;
      const alpha = spent ? 0.61 : 1;
      if (node.alpha !== alpha) node.setAlpha(alpha);
      const texture =
        spent && resource.item === "wood" ? resource.spent : resource.asset;
      if (node.texture.key !== texture) node.setTexture(texture);
    }
  }

  playSound() {
    this.sound.play("alert", { volume: 0.2 });
  }

  async toggleMusic() {
    this.music ??= this.sound.add("village", { loop: true, volume: 0.16 });
    if (this.music.isPlaying) {
      this.music.stop();
      return false;
    }
    if (
      this.sound instanceof Phaser.Sound.WebAudioSoundManager &&
      this.sound.context.state === "suspended"
    )
      await this.sound.context.resume();
    if (!this.music.play()) throw Error("音频未启动");
    return true;
  }

  update(_time: number, elapsed: number) {
    if (
      !this.player ||
      !this.shadow ||
      !this.view ||
      !this.current ||
      !this.marker
    )
      return;
    const { state, moving, working } = this.current;
    const { x, y, facing } = state.player;
    const sprite = this.player;
    if (sprite.x !== x || sprite.y !== y) {
      const remaining = Math.pow(0.08, elapsed / 50);
      const settle = (actual: number, target: number) =>
        Math.abs(actual - target) < 0.01
          ? target
          : target + (actual - target) * remaining;
      sprite.setPosition(settle(sprite.x, x), settle(sprite.y, y));
    }
    if (this.shadow.x !== sprite.x || this.shadow.y !== sprite.y - 1)
      this.shadow.setPosition(sprite.x, sprite.y - 1);
    if (sprite.depth !== sprite.y) sprite.setDepth(sprite.y);
    if (this.shadow.depth !== sprite.y - 0.5)
      this.shadow.setDepth(sprite.y - 0.5);

    if (!this.halted && moving) {
      const key = `walk-${facing}`;
      if (sprite.anims.currentAnim?.key !== key || !sprite.anims.isPlaying)
        sprite.play(key, true);
    } else {
      if (sprite.anims.isPlaying) sprite.stop();
      const frame = animations.directionColumns[facing];
      if (
        sprite.texture.key !== "player-idle" ||
        String(sprite.frame.name) !== String(frame)
      )
        sprite.setTexture("player-idle", frame);
    }

    if (this.markerPlayer?.x !== x || this.markerPlayer?.y !== y) {
      this.markerPlayer = state.player;
      this.markerTarget = nearbyTarget(state.player);
    }
    const target = this.markerTarget;
    const show = !this.halted && !this.overview && Boolean(working || target);
    if (this.marker.visible !== show) this.marker.setVisible(show);
    if (show && working) {
      if (this.marker.texture.key !== "toolbox")
        this.marker.setTexture("toolbox");
      if (this.marker.x !== sprite.x || this.marker.y !== sprite.y - 19)
        this.marker.setPosition(sprite.x, sprite.y - 19);
    } else if (show && target) {
      const node = this.nodeSprites.get(target.id);
      const height =
        target.id === valley.ruin.id
          ? 56
          : target.id === valley.bridge.id
            ? 23
            : node
              ? node.height + 2
              : 36;
      if (this.marker.texture.key !== "arrow") this.marker.setTexture("arrow");
      if (this.marker.x !== target.x || this.marker.y !== target.y - height)
        this.marker.setPosition(target.x, target.y - height);
    }

    this.setDebug("direction", facing);
    this.setDebug("frame", String(sprite.frame.name));
    this.setDebug("moving", String(moving));
    this.setDebug("working", String(working));
    this.setDebug("cameraX", this.cameras.main.scrollX.toFixed(2));
    this.setDebug("cameraY", this.cameras.main.scrollY.toFixed(2));
  }

  private setDebug(key: string, value: string) {
    const data = this.view?.dataset;
    if (data && data[key] !== value) data[key] = value;
  }

  private drawTerrain() {
    const texture = this.textures.createCanvas("terrain", mapWidth, mapHeight)!;
    const groundImage = this.textures
      .get("valley-ground")
      .getSourceImage() as CanvasImageSource;
    const riverImage = this.textures
      .get("valley-river")
      .getSourceImage() as CanvasImageSource;
    const side = valley.tileSize;
    for (let y = 0; y < valley.height; y++) {
      for (let x = 0; x < valley.width; x++) {
        const sx = x * side,
          sy = y * side;
        texture.context.drawImage(
          groundImage,
          valley.ground[y][x] * side,
          0,
          side,
          side,
          sx,
          sy,
          side,
          side,
        );
        const river = valley.river[y][x];
        if (river >= 0)
          texture.context.drawImage(
            riverImage,
            river * side,
            0,
            side,
            side,
            sx,
            sy,
            side,
            side,
          );
      }
    }
    texture.refresh();
    this.add.image(0, 0, "terrain").setOrigin(0).setDepth(-1000);
  }

  private resizeView() {
    if (!this.view || !this.game.canvas) return;
    const scale = 2;
    const width = Math.max(1, Math.floor(this.view.clientWidth / scale));
    const height = Math.max(1, Math.floor(this.view.clientHeight / scale));
    this.scale.resize(width, height);
    this.game.canvas.style.width = `${width * scale}px`;
    this.game.canvas.style.height = `${height * scale}px`;
    this.setOverview(this.overview);
  }

  private drawShadow(x: number, y: number) {
    return this.add.ellipse(x, y - 1, 12, 4, 0x29291e, 0.32).setDepth(y - 0.5);
  }

  private nameplate(x: number, y: number, name: string) {
    this.add
      .text(x, y - 19, name, {
        fontFamily:
          '"Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", sans-serif',
        fontStyle: "bold",
        fontSize: "9px",
        color: "#f9ecce",
        backgroundColor: "#294039",
        padding: { x: 3, y: 1 },
      })
      .setOrigin(0.5, 1)
      .setDepth(900);
  }
}
import type { Action, Result, Snapshot } from "../shared/protocol.js";
import {
  distance,
  items,
  nearbyTarget,
  residents,
  resources,
  valley,
} from "../shared/world.js";

export function element<T extends HTMLElement = HTMLElement>(id: string) {
  return document.getElementById(id) as T;
}

const targetName = element("target");
const feedback = element("feedback");
const feedbackIcon = element<HTMLImageElement>("feedback-icon");
const primary = element<HTMLButtonElement>("interact");
const inspect = element<HTMLButtonElement>("bridge-check");
const progress = element<HTMLProgressElement>("progress");
const location = element("location");
const percentLabel = element("percent");
const deliveredWood = element("bridge-wood");
const deliveredStone = element("bridge-stone");
const objective = element("objective");
const nextStep = element("next-step");
const goal = document.querySelector(".goal")!;
const itemCounts = new Map<string, HTMLElement>();
const bridge = valley.bridge;

export function setText(node: HTMLElement, value: string) {
  if (node.textContent !== value) node.textContent = value;
}

function icon(key: string, className = "pixel") {
  const image = document.createElement("img");
  image.className = className;
  image.src = `/assets/${key}.png`;
  image.alt = "";
  return image;
}

function label(value: string, tag = "span") {
  const node = document.createElement(tag);
  node.textContent = value;
  return node;
}

export function furnishJournal() {
  for (const [key, name] of Object.entries(items)) {
    const item = label("", "li");
    item.className = "item";
    const count = label("0", "strong");
    count.dataset.item = key;
    item.append(icon(key), label(name), count);
    element("inventory").append(item);
    itemCounts.set(key, count);
  }
  for (const resident of valley.residents) {
    const row = label("", "li");
    row.className = "resident";
    const face = label("");
    face.className = "resident-face";
    face.append(icon(`${resident.asset}-face`));
    row.append(
      face,
      label(resident.name, "strong"),
      label(resident.role, "small"),
    );
    element("residents").append(row);
  }
}

let selection:
  (Pick<Action, "target" | "verb"> & { label: string }) | undefined;
let lastTarget: string | undefined;
let lastVerb: string | undefined;
let lastHint = "";
let shownResult = false;
let renderedSelection = false;

export function showResult(result: Result) {
  if (result.code === "RESET") {
    shownResult = false;
    lastTarget = undefined;
  } else shownResult = true;
  feedback.textContent = result.text;
}

export function showFinished() {
  shownResult = true;
  feedback.textContent = "旧桥修好了。沿桥向东，去查看航标遗迹。";
}

export function showFeedback(text: string) {
  shownResult = true;
  feedback.textContent = text;
}

export function selectedAction() {
  return selection;
}

export function enableActions(enabled: boolean) {
  const disabled = !enabled || !selection;
  if (primary.disabled !== disabled) primary.disabled = disabled;
  if (inspect.disabled === enabled) inspect.disabled = !enabled;
}

export function render(snapshot: Snapshot, enabled: boolean) {
  const { state, now, working } = snapshot;
  for (const [key, amount] of Object.entries(state.inventory))
    setText(itemCounts.get(key)!, String(amount));
  setText(
    location,
    valley.regions.find(
      (region) => distance(region, state.player) < region.radius,
    )?.name ?? "雾灯谷小径",
  );
  const built = state.bridge;
  const hasMaterials =
    built.wood === bridge.required.wood &&
    built.stone === bridge.required.stone;
  const percent = Math.floor((built.progressMs / bridge.workMs) * 100);
  if (progress.value !== percent) progress.value = percent;
  setText(percentLabel, `${percent}%`);
  setText(deliveredWood, `${built.wood} / ${bridge.required.wood}`);
  setText(deliveredStone, `${built.stone} / ${bridge.required.stone}`);
  setText(
    objective,
    state.explored
      ? "旅程完成"
      : built.repaired
        ? "查看航标遗迹"
        : "修复雾灯旧桥",
  );
  setText(
    nextStep,
    state.explored
      ? "你已在东岸找到航标线索，可以继续探索雾灯谷。"
      : built.repaired
        ? "穿过旧桥，顺着东岸小路前往航标遗迹。"
        : working
          ? "正在铺设桥板。留在渡口，直到施工完成。"
          : hasMaterials
            ? "材料已到位。在渡口开始施工。"
            : built.discovered
              ? "北坡林地采木，南坡岩场取石，再回渡口交付。"
              : "向东走到河边，查看雾灯旧桥。",
  );
  if (goal.hasAttribute("data-complete") !== built.repaired)
    goal.toggleAttribute("data-complete", built.repaired);

  const target = nearbyTarget(state.player);
  let nextSelection: typeof selection;
  let hint = "沿小路探索，靠近居民或采集点后按 E。";
  let image = "player-face";
  if (target) {
    const resident = residents.get(target.id);
    const resource = resources.get(target.id);
    if (resident) {
      image = `${resident.asset}-face`;
      const conversational = target.id === "cenyan";
      hint = conversational
        ? "木匠 · 和岑砚聊聊。"
        : `${resident.role} · 听听${resident.name}的介绍。`;
      nextSelection = {
        target: target.id,
        verb: "inspect",
        label: conversational ? "与岑砚交谈" : "认识居民",
      };
    } else if (resource) {
      image = resource.item;
      const wait = Math.ceil(((state.cooldowns[target.id] ?? 0) - now) / 1000);
      hint =
        wait > 0
          ? `约 ${wait} 秒后可再次采集。`
          : `可采集${items[resource.item]} ×${resource.yieldCount}。`;
      nextSelection = {
        target: target.id,
        verb: "collect",
        label: `采集${items[resource.item]}`,
      };
    } else if (target.id === bridge.id) {
      image = "toolbox";
      if (!built.discovered || built.repaired) {
        hint = built.repaired
          ? "桥面已经恢复，从渡口向东可以过河。"
          : "桥板断裂，河水截断了去东岸的路。";
        nextSelection = {
          target: bridge.id,
          verb: "inspect",
          label: "查看旧桥",
        };
      } else if (!hasMaterials) {
        hint = `交付木材 ×${bridge.required.wood - built.wood}、石材 ×${bridge.required.stone - built.stone}。`;
        nextSelection = {
          target: bridge.id,
          verb: "deliver",
          label: "交付材料",
        };
      } else if (working) {
        hint = "留在渡口完成施工，走动会暂停。";
        nextSelection = { target: bridge.id, verb: "stop", label: "暂停施工" };
      } else {
        hint = "材料已就位，按 E 开始施工。";
        nextSelection = { target: bridge.id, verb: "work", label: "开始施工" };
      }
    } else {
      image = "letter";
      hint = "石面刻着磨损的星纹。";
      nextSelection = { target: target.id, verb: "inspect", label: "查看航标" };
    }
  }
  const changed = target?.id !== lastTarget;
  const actionChanged = nextSelection?.verb !== lastVerb;
  if (changed) shownResult = false;
  if (changed || actionChanged || !renderedSelection) {
    renderedSelection = true;
    targetName.textContent = target?.name ?? "探索雾灯谷";
    if (target) {
      feedbackIcon.src = `/assets/${image}.png`;
      feedbackIcon.hidden = false;
    } else feedbackIcon.hidden = true;
    primary.replaceChildren(
      document.createTextNode((nextSelection?.label ?? "附近无交互") + " "),
      label("E", "kbd"),
    );
    inspect.hidden =
      target?.id !== bridge.id || nextSelection?.verb === "inspect";
  }
  if (!shownResult && (changed || hint !== lastHint))
    feedback.textContent = hint;
  lastTarget = target?.id;
  lastVerb = nextSelection?.verb;
  lastHint = hint;
  selection = nextSelection;
  enableActions(enabled);
}
import {
  dialogueInputLimit,
  type ClientMessage,
  type DialogueEvent,
} from "../shared/protocol.js";
import { residents } from "../shared/world.js";
import { element } from "./ui.js";

export function bindDialogue(callbacks: {
  send: (message: ClientMessage) => boolean;
  feedback: (text: string) => void;
  changed: () => void;
}) {
  const panel = element<HTMLDialogElement>("cenyan-dialogue");
  const input = element<HTMLTextAreaElement>("dialogue-input");
  const send = element<HTMLButtonElement>("dialogue-send");
  const retry = element<HTMLButtonElement>("dialogue-retry");
  const mode = element("dialogue-mode");
  const transcript = element("dialogue-transcript");
  const pending = element("dialogue-pending");
  const error = element("dialogue-error");
  let opening: string | undefined;
  let dialogId: string | undefined;
  let request: { id: string; text: string } | undefined;
  let failedText: string | undefined;
  let composing = false;
  let composedAt = -Infinity;

  input.maxLength = dialogueInputLimit;
  const active = () => Boolean(dialogId || opening);
  function append(who: string, text: string) {
    const row = document.createElement("p");
    const name = document.createElement("strong");
    name.textContent = who;
    const content = document.createElement("span");
    content.textContent = text;
    row.append(name, content);
    transcript.append(row);
    transcript.scrollTop = transcript.scrollHeight;
  }

  function progress(busy: boolean) {
    pending.hidden = !busy;
    send.disabled = busy;
    retry.disabled = busy;
  }

  function showError(text: string, allowRetry = false) {
    error.textContent = text;
    error.hidden = !text;
    retry.hidden = !allowRetry;
  }

  function close(notify = true) {
    if (!active() && !panel.open) return;
    const current = dialogId;
    opening = undefined;
    dialogId = undefined;
    request = undefined;
    failedText = undefined;
    composing = false;
    if (notify && current)
      callbacks.send({ type: "dialogue-close", dialogId: current });
    if (panel.open) panel.close();
    callbacks.changed();
  }

  function open() {
    if (active()) return;
    const id = crypto.randomUUID();
    if (!callbacks.send({ type: "dialogue-open", id, npc: "cenyan" })) {
      callbacks.feedback("暂时无法开启对话，连接恢复后再试。");
      return;
    }
    opening = id;
    callbacks.changed();
  }

  function submit(text: string, repeat = false) {
    if (!dialogId || request || composing) return;
    text = text.trim();
    if (!text || text.length > dialogueInputLimit) {
      showError(`请输入 1 至 ${dialogueInputLimit} 个字符。`);
      return;
    }
    const id = crypto.randomUUID();
    if (!callbacks.send({ type: "dialogue-send", id, dialogId, text })) {
      showError("连接暂不可用。可以再试一次。", repeat);
      return;
    }
    if (!repeat) {
      append("旅人", text);
      input.value = "";
    }
    request = { id, text };
    failedText = undefined;
    showError("");
    progress(true);
    input.focus();
  }

  function receive(message: DialogueEvent) {
    if (message.event === "opened") {
      if (opening !== message.requestId) {
        callbacks.send({ type: "dialogue-close", dialogId: message.dialogId });
        return;
      }
      opening = undefined;
      dialogId = message.dialogId;
      mode.dataset.mode = message.mode;
      mode.textContent =
        message.mode === "mock" ? "模拟对话 · Mock" : "已配置模型 · Live";
      transcript.replaceChildren();
      input.value = "";
      failedText = undefined;
      composedAt = -Infinity;
      showError("");
      progress(false);
      panel.show();
      input.focus();
      callbacks.feedback(residents.get("cenyan")!.intro);
      callbacks.changed();
      return;
    }
    if (message.event === "error" && message.requestId === opening) {
      close(false);
      callbacks.feedback(message.text);
      return;
    }
    if (!dialogId || message.dialogId !== dialogId) return;
    if (message.event === "closed") {
      close(false);
      callbacks.feedback(message.text);
      return;
    }
    if (
      !request ||
      message.requestId !== request.id ||
      message.event === "pending"
    )
      return;
    const text = request.text;
    request = undefined;
    progress(false);
    if (message.event === "reply") append("岑砚", message.text);
    else {
      failedText = text;
      showError(message.text, true);
    }
  }

  element("dialogue-close").addEventListener("click", () => close());
  panel.addEventListener("keydown", (event) => {
    if (
      event.key !== "Escape" ||
      event.isComposing ||
      composing ||
      event.keyCode === 229
    )
      return;
    event.preventDefault();
    event.stopPropagation();
    close();
  });
  input.addEventListener("compositionstart", () => {
    composing = true;
  });
  input.addEventListener("compositionend", () => {
    composing = false;
    composedAt = performance.now();
  });
  input.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" || event.shiftKey) return;
    if (event.isComposing || composing || event.keyCode === 229) return;
    event.preventDefault();
    // Some IMEs dispatch the candidate Enter after compositionend.
    if (performance.now() - composedAt >= 70) submit(input.value);
  });
  send.addEventListener("click", () => submit(input.value));
  retry.addEventListener("click", () => {
    if (failedText) submit(failedText, true);
  });
  for (const suggestion of panel.querySelectorAll<HTMLButtonElement>(
    "[data-suggestion]",
  )) {
    suggestion.addEventListener("click", () => {
      input.value = suggestion.dataset.suggestion ?? "";
      input.focus();
    });
  }
  return { active, open, close, receive };
}
import {
  saveSchema,
  schemaVersion,
  type ClientMessage,
  type DialogueEvent,
  type Result,
  type Snapshot,
} from "../shared/protocol.js";
import { valley } from "../shared/world.js";

export type ConnectionStatus = {
  kind: "connecting" | "online" | "retrying" | "failed" | "occupied";
  detail: string;
};

export class Connection {
  private socket?: WebSocket;
  private attempt = 0;
  private retryTimer?: number;
  private watchdog?: number;
  private retryDelay = 500;

  constructor(
    private readonly callbacks: {
      status: (status: ConnectionStatus) => void;
      snapshot: (snapshot: Snapshot) => void;
      result: (result: Result) => void;
      dialogue: (event: DialogueEvent) => void;
      error: (message: string) => void;
    },
  ) {}

  async connect() {
    clearTimeout(this.retryTimer);
    clearTimeout(this.watchdog);
    const attempt = ++this.attempt;
    this.socket?.close();
    this.callbacks.status({
      kind: "connecting",
      detail: "正在连接服务并读取存档。",
    });
    try {
      const response = await fetch("/health", {
        cache: "no-store",
        signal: AbortSignal.timeout(4000),
      });
      if (attempt !== this.attempt) return;
      if (response.status === 503) {
        const body = await response.json();
        if (attempt !== this.attempt) return;
        if (body.status === "save_error") {
          this.callbacks.status({ kind: "failed", detail: body.message });
          return;
        }
      }
      if (!response.ok) throw Error();
      const health = await response.json();
      if (attempt !== this.attempt) return;
      if (
        health.status !== "ok" ||
        health.phase !== 2 ||
        health.schemaVersion !== schemaVersion ||
        health.contentVersion !== valley.contentVersion
      ) {
        this.callbacks.status({
          kind: "failed",
          detail: "服务与当前地图版本不一致，请重新启动本地游戏。",
        });
        return;
      }
      this.open(attempt);
    } catch {
      if (attempt === this.attempt) this.retry("HTTP 服务无法连接，正在重试。");
    }
  }

  send(message: ClientMessage) {
    if (this.socket?.readyState !== WebSocket.OPEN) return false;
    this.socket.send(JSON.stringify(message));
    return true;
  }

  private open(attempt: number) {
    const scheme = location.protocol === "https:" ? "wss:" : "ws:";
    const socket = new WebSocket(`${scheme}//${location.host}/ws`);
    this.socket = socket;
    let ready = false;
    let terminal = false;
    const timeout = () => {
      clearTimeout(this.watchdog);
      this.watchdog = window.setTimeout(() => {
        terminal = true;
        this.retry(
          ready ? "连接超时，正在恢复存档。" : "WebSocket 连接超时，正在重试。",
        );
        socket.close();
      }, 5500);
    };
    timeout();
    socket.addEventListener("message", (event) => {
      if (attempt !== this.attempt || terminal) return;
      try {
        const message = JSON.parse(event.data);
        if (message.type === "snapshot") {
          const state = saveSchema.parse(message.state);
          if (
            !Number.isFinite(message.now) ||
            typeof message.moving !== "boolean" ||
            typeof message.working !== "boolean"
          )
            throw Error("Invalid snapshot");
          if (!ready) {
            ready = true;
            this.retryDelay = 500;
            this.callbacks.status({ kind: "online", detail: "存档已连接" });
          }
          timeout();
          this.callbacks.snapshot({ ...message, state });
        } else if (message.type === "dialogue") {
          this.callbacks.dialogue(message);
        } else if (message.type === "result") {
          this.callbacks.result(message);
        } else if (message.type === "error" && message.code === "SAVE_ERROR") {
          terminal = true;
          this.callbacks.status({ kind: "failed", detail: message.text });
        } else if (message.type === "error") {
          this.callbacks.error(message.text);
        }
      } catch {
        terminal = true;
        this.callbacks.status({
          kind: "failed",
          detail: "收到无法读取的游戏状态。请重新连接。",
        });
        socket.close();
      }
    });
    socket.addEventListener("close", (event) => {
      if (attempt !== this.attempt) return;
      clearTimeout(this.watchdog);
      if (terminal) return;
      if (event.code === 4001) {
        this.callbacks.status({
          kind: "occupied",
          detail: "另一浏览器标签页正在游玩。",
        });
        return;
      }
      this.retry(
        ready
          ? "与雾灯谷失去连接，正在恢复存档。"
          : "WebSocket 连接失败，正在重试。",
      );
    });
  }

  private retry(detail: string) {
    this.callbacks.status({ kind: "retrying", detail });
    this.retryTimer = window.setTimeout(
      () => void this.connect(),
      this.retryDelay,
    );
    this.retryDelay = Math.min(2200, this.retryDelay * 2);
  }
}
import type { ClientMessage } from "../shared/protocol.js";

const movement = {
  KeyW: "up",
  ArrowUp: "up",
  KeyS: "down",
  ArrowDown: "down",
  KeyA: "left",
  ArrowLeft: "left",
  KeyD: "right",
  ArrowRight: "right",
} as const;
type Key = keyof typeof movement;
type Direction = (typeof movement)[Key];

export function bindInput(callbacks: {
  canMove: () => boolean;
  send: (message: ClientMessage) => boolean;
  interact: () => void;
  pause: () => void;
  blurred: () => void;
}) {
  const held = new Set<Key>();
  const pointers = new Map<number, Direction>();
  function send() {
    if (!callbacks.canMove()) return;
    const directions = new Set([
      ...Array.from(held, (key) => movement[key]),
      ...pointers.values(),
    ]);
    callbacks.send({
      type: "move",
      dx: (Number(directions.has("right")) - Number(directions.has("left"))) as
        -1 | 0 | 1,
      dy: (Number(directions.has("down")) - Number(directions.has("up"))) as
        -1 | 0 | 1,
    });
  }
  function clear() {
    held.clear();
    pointers.clear();
    callbacks.send({ type: "move", dx: 0, dy: 0 });
  }
  function keyIsMovement(code: string): code is Key {
    return Object.hasOwn(movement, code);
  }
  window.addEventListener("keydown", (event) => {
    if (
      event.ctrlKey ||
      event.altKey ||
      event.metaKey ||
      document.querySelector("dialog[open]")
    )
      return;
    const code = event.code;
    if (!event.repeat && code === "Escape") {
      event.preventDefault();
      callbacks.pause();
    } else if (!event.repeat && code === "KeyE") {
      event.preventDefault();
      callbacks.interact();
    } else if (keyIsMovement(code) && callbacks.canMove()) {
      event.preventDefault();
      if (!event.repeat) {
        held.add(code);
        send();
      }
    }
  });
  window.addEventListener("keyup", (event) => {
    if (keyIsMovement(event.code) && held.delete(event.code)) {
      event.preventDefault();
      send();
    }
  });
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-move]",
  )) {
    button.addEventListener("pointerdown", (event) => {
      if (!callbacks.canMove()) return;
      event.preventDefault();
      button.setPointerCapture(event.pointerId);
      pointers.set(event.pointerId, button.dataset.move as Direction);
      send();
    });
    function release(event: PointerEvent) {
      if (pointers.delete(event.pointerId)) send();
    }
    button.addEventListener("pointerup", release);
    button.addEventListener("pointercancel", release);
    button.addEventListener("lostpointercapture", release);
  }
  window.addEventListener("blur", clear);
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) {
      clear();
      callbacks.blurred();
    }
  });
  window.setInterval(() => {
    if (held.size || pointers.size) send();
  }, 130);
  return { clear };
}

