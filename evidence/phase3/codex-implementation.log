import { z } from \"zod\";
import { residents, valley } from \"./world.js\";

export const cenyanId = \"cenyan\";
export const home = { ...residents.get(cenyanId)"'!, id: "cenyan-home", name: "木匠工坊", range: 12 };
export const destinations = [home, valley.bridge, valley.ruin, ...valley.resources];
export const destinationNames = new Map(destinations.map(({ id, name }) => [id, name]));

export const goals = {
  "repair-bridge": "修复旧桥",
  "stock-wood": "储备屋顶木料",
  rest: "休整",
} as const;

const goal = z.enum(["repair-bridge", "stock-wood", "rest"]);
