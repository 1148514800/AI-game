import { isPassable, type Point } from "../src/shared/world.js";

type Stop = Point & { axis: "x" | "y" };
const grid = 8;
const cardinal = [
  [1, 0],
  [-1, 0],
  [0, 1],
  [0, -1],
];

export function route(
  start: Point,
  reached: (point: Point) => boolean,
  repaired: boolean,
): Stop[] {
  if (reached(start)) return [];
  const queue = [{ point: start, parent: -1, axis: "x" as Stop["axis"] }];
  const visited = new Set(["0,0"]);
  let found = -1;
  function clear(x: number, y: number) {
    return (
      isPassable(x - 3, y - 3, repaired) &&
      isPassable(x + 3, y + 3, repaired) &&
      isPassable(x + 3, y - 3, repaired) &&
      isPassable(x - 3, y + 3, repaired)
    );
  }
  for (let i = 0; i < queue.length; i++) {
    const { point } = queue[i];
    if (reached(point)) {
      found = i;
      break;
    }
    for (const [dx, dy] of cardinal) {
      const next = { x: point.x + dx * grid, y: point.y + dy * grid };
      // Lattice indices stay stable when the start is a fractional server position.
      const key = `${Math.round((next.x - start.x) / grid)},${Math.round((next.y - start.y) / grid)}`;
      if (
        visited.has(key) ||
        !clear(next.x, next.y) ||
        !clear(point.x + dx * 4, point.y + dy * 4)
      )
        continue;
      visited.add(key);
      queue.push({ point: next, parent: i, axis: dx ? "x" : "y" });
    }
  }
  if (found < 0) throw Error("No walkable route from current position");
  const steps: Stop[] = [];
  for (let i = found; queue[i].parent >= 0; i = queue[i].parent) {
    const { point, axis } = queue[i];
    if (steps.at(-1)?.axis !== axis) steps.push({ ...point, axis });
  }
  return steps.reverse();
}
"""Run Phase 2 checks without model credentials and save separate evidence."""
import datetime
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
TIMEZONE = datetime.timezone(datetime.timedelta(hours=8))
stamp = datetime.datetime.now(TIMEZONE).strftime("%Y%m%d-%H%M%S-%f")
evidence = ROOT / "evidence" / "phase2" / f"verification-{stamp}"
evidence.mkdir(parents=True)
environment = {name: os.environ[name] for name in (
    "PATH", "HOME", "USERPROFILE", "SYSTEMROOT", "TMPDIR", "TMP", "TEMP",
    "PLAYWRIGHT_BROWSERS_PATH", "LANG", "LC_ALL",
) if name in os.environ}
environment.update(MISTSEA_EVIDENCE=str(evidence), LLM_ENABLED="false", npm_config_fetch_retries="0")
results = []


def run(command, filename, *, extra=None, skip=None):
    started = datetime.datetime.now(TIMEZONE).isoformat()
    path = evidence / filename
    code = None
    with path.open("w") as output:
        if skip:
            print(skip, file=output)
        else:
            try:
                code = subprocess.run(command, cwd=ROOT, env={**environment, **(extra or {})},
                                      stdout=output, stderr=subprocess.STDOUT, check=False).returncode
            except OSError as error:
                print(error, file=output)
                code = 1
    result = {"command": " ".join(command), "exitCode": code, "startedAt": started,
              "log": str(path.relative_to(ROOT))}
    if skip:
        result["notRun"] = skip
    results.append(result)
    print(result, flush=True)
    (evidence / "command-results.json").write_text(
        json.dumps(results, ensure_ascii=False, indent=2) + "\n")
    return code


print(f"Evidence: {evidence.relative_to(ROOT)}", flush=True)
if run(["npm", "ci"], "npm-ci.log") != 0:
    run(["npm", "ci", "--ignore-scripts"], "npm-ci-ignore-scripts.log")
run(["node", "scripts/dev-smoke.mjs"], "dev.log")
run(["npm", "run", "typecheck"], "typecheck.log")
run(["node", "node_modules/typescript/bin/tsc", "-p", "scripts/performance/tsconfig.json"], "performance-typecheck.log")
run(["npm", "test"], "unit-test.log")
run(["npm", "run", "test:integration"], "integration.log")
run(["npm", "run", "test:e2e", "--", "--list"], "e2e-list.log")
run(["npm", "run", "test:e2e"], "e2e.log")
build = run(["npm", "run", "build"], "build.log", extra={"LLM_API_KEY": "phase2-build-dummy-key-do-not-expose"})
skip_build = "No fresh production build." if build else None
run(["node", "scripts/assert-client-no-secret.mjs"], "client-key-sentinel.log", skip=skip_build)
run(["node", "scripts/production-smoke.mjs"], "production-smoke.log", skip=skip_build)
run(["node", "--import", "tsx", "scripts/performance/run.ts", "after", "--mock-ui",
     "scripts/performance/mock-ui.json"], "performance-after.log")
if "setsockopt: Operation not permitted" in (evidence / "performance-after.log").read_text():
    print("Chromium startup was blocked in the performance harness.", flush=True)
sys.exit(any(result["exitCode"] != 0 for result in results))
import { spawn } from "node:child_process";
import { once } from "node:events";
import { mkdtempSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { setTimeout as delay } from "node:timers/promises";

const dir = mkdtempSync(join(tmpdir(), "mistsea-phase2-dev-"));
const node = spawn(process.execPath, ["scripts/dev.mjs"], {
  env: {
    PATH: process.env.PATH,
    MISTSEA_SAVE: join(dir, "world.sqlite"),
    HOST: "127.0.0.1",
    PORT: "3005",
    MISTSEA_VITE_PORT: "5175",
    LLM_ENABLED: "false",
  },
  stdio: "inherit",
});
const done = once(node, "close");
try {
  const until = Date.now() + 8000;
  let ready = false;
  while (
    Date.now() < until &&
    node.exitCode === null &&
    node.signalCode === null
  ) {
    const page = await fetch("http://127.0.0.1:5175/", {
      signal: AbortSignal.timeout(500),
    }).catch(() => null);
    const health = await fetch("http://127.0.0.1:5175/health", {
      signal: AbortSignal.timeout(500),
    }).catch(() => null);
    if (
      page?.ok &&
      health?.ok &&
      (await health.json()).status === "ok" &&
      (await page.text()).includes("雾灯谷")
    ) {
      ready = true;
      console.log(
        "Development entrypoint served the game and proxied SQLite health.",
      );
      break;
    }

    await delay(100);
  }
  if (node.exitCode !== null || node.signalCode !== null)
    throw Error(
      `Development process exited before readiness: ${node.signalCode ?? node.exitCode}`,
    );
  if (!ready) throw Error("Development game did not become ready.");
} finally {
  if (node.exitCode === null && node.signalCode === null) node.kill("SIGTERM");
  await done;
  rmSync(dir, { recursive: true, force: true });
}
import { spawn } from "node:child_process";
import { once } from "node:events";
import { closeSync, mkdirSync, mkdtempSync, openSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { chromium, expect } from "@playwright/test";

const evidence = process.env.MISTSEA_EVIDENCE ?? "evidence/phase2";
mkdirSync(evidence, { recursive: true });
const directory = mkdtempSync(join(tmpdir(), "mistsea-production-"));
const output = openSync(join(evidence, "production-server.log"), "w");
const url = "http://127.0.0.1:3002";
const child = spawn(process.execPath, ["release/server/src/server/index.js"], {
  env: {
    PATH: process.env.PATH,
    PORT: "3002",
    HOST: "127.0.0.1",
    MISTSEA_SAVE: join(directory, "valley.sqlite"),
  },
  stdio: ["ignore", output, output],
});
let browser;

try {
  await expect
    .poll(
      async () => {
        if (child.exitCode !== null)
          throw Error(
            `Compiled server exited ${child.exitCode}; see production-server.log`,
          );
        try {
          return (await fetch(`${url}/health`)).json();
        } catch {
          return null;
        }
      },
      { timeout: 10000 },
    )
    .toMatchObject({
      status: "ok",
      phase: 2,
      schemaVersion: 1,
      contentVersion: 1,
    });
  browser = await chromium.launch({
    chromiumSandbox: true,
    ignoreDefaultArgs: ["--enable-unsafe-swiftshader"],
  });
  const page = await browser.newPage({
    viewport: { width: 1280, height: 960 },
  });
  const errors = [];
  page.on("pageerror", (error) => errors.push(error.message));
  page.on("console", (message) => {
    if (message.type() === "error") errors.push(message.text());
  });
  page.on("request", (request) => {
    if (
      new URL(request.url()).origin !== url &&
      !request.url().startsWith("data:")
    )
      errors.push(request.url());
  });
  page.on("response", (response) => {
    if (response.status() >= 400)
      errors.push(`${response.status()} ${response.url()}`);
  });
  await page.goto(url);
  const stage = page.locator("#game");
  await expect(stage).toHaveAttribute("data-ready", "true");
  await expect(page.locator("canvas")).toBeVisible();
  await expect(page.locator("#objective")).toHaveText("修复雾灯旧桥");
  const initial = Number(await stage.getAttribute("data-x"));
  await page.keyboard.down("d");
  try {
    await expect
      .poll(async () => Number(await stage.getAttribute("data-x")))
      .toBeGreaterThan(initial + 10);
  } finally {
    await page.keyboard.up("d");
  }
  await expect(stage).toHaveAttribute("data-moving", "false");
  await page.screenshot({
    path: join(evidence, "scene-production.png"),
    fullPage: true,
  });
  expect(errors).toEqual([]);
  console.log(
    "PASS: compiled Fastify, SQLite, WebSocket, local assets and keyboard movement without API keys.",
  );
} finally {
  if (browser) await browser.close();
  if (child.exitCode === null && child.signalCode === null) {
    const exit = once(child, "exit");
    child.kill("SIGTERM");
    await exit;
  }
  closeSync(output);
  rmSync(directory, { recursive: true, force: true });
}
