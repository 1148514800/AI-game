import type {
  ClientMessage,
  Action,
  Result,
  SaveState,
  Snapshot,
} from "../shared/protocol.js";
import {
  distance,
  inventoryLimit,
  isPassable,
  items,
  residents,
  resources,
  speed,
  tickMs,
  valley,
} from "../shared/world.js";
import type { PublicBridge } from "./dialogue/cenyan.js";
import { freshState, SaveFile } from "./save.js";

const leaseMs = 420;
const bridge = valley.bridge;

function reply(
  action: Action,
  ok: boolean,
  code: string,
  text: string,
): Result {
  return {
    type: "result",
    id: action.id,
    target: action.target,
    ok,
    code,
    text,
  };
}

export class World {
  private state: SaveState;
  private intent = { dx: 0, dy: 0, expires: 0 };
  private working = false;
  private moving = false;
  private dirty = false;
  private positionSavedAt = 0;

  constructor(private readonly save: SaveFile) {
    this.state = structuredClone(save.initial);
  }

  get activity() {
    return { moving: this.moving, working: this.working };
  }

  canTalkToCenyan() {
    const npc = residents.get("cenyan");
    return !!npc && distance(this.state.player, npc) <= npc.range;
  }

  publicBridge(): PublicBridge {
    const value = this.state.bridge;
    return {
      discovered: value.discovered,
      wood: value.wood,
      stone: value.stone,
      woodRequired: bridge.required.wood,
      stoneRequired: bridge.required.stone,
      progressPercent: Math.floor((value.progressMs * 100) / bridge.workMs),
      repaired: value.repaired,
    };
  }

  snapshot(now = Date.now()): Snapshot {
    return {
      type: "snapshot",
      now,
      state: structuredClone(this.state),
      moving: this.moving,
      working: this.working,
    };
  }

  setMovement(
    { dx, dy }: Extract<ClientMessage, { type: "move" }>,
    clock: number,
  ) {
    this.intent = { dx, dy, expires: clock + leaseMs };
    if (dx || dy) this.working = false;
  }

  tick(clock: number, elapsed: number) {
    const stepMs = Math.min(tickMs, Math.max(0, elapsed));
    const { dx, dy } =
      this.intent.expires > clock ? this.intent : { dx: 0, dy: 0 };
    const player = this.state.player;
    this.moving = false;
    if (dx || dy) {
      const step = (speed * stepMs) / 1000 / Math.hypot(dx, dy);
      const facing =
        Math.abs(dx) >= Math.abs(dy)
          ? dx < 0
            ? "left"
            : "right"
          : dy < 0
            ? "up"
            : "down";
      const x = isPassable(
        player.x + dx * step,
        player.y,
        this.state.bridge.repaired,
      )
        ? player.x + dx * step
        : player.x;
      const y = isPassable(x, player.y + dy * step, this.state.bridge.repaired)
        ? player.y + dy * step
        : player.y;
      this.moving = x !== player.x || y !== player.y;
      if (this.moving || player.facing !== facing) {
        this.state = { ...this.state, player: { x, y, facing } };
        this.dirty = true;
      }
    }
    if (this.working && stepMs > 0) {
      const progressMs = Math.min(
        bridge.workMs,
        this.state.bridge.progressMs + stepMs,
      );
      const repaired = progressMs === bridge.workMs;
      this.commit({
        ...this.state,
        bridge: { ...this.state.bridge, progressMs, repaired },
      });
      if (repaired) this.working = false;
    }
    if (this.dirty && clock - this.positionSavedAt >= 5000) {
      this.flush();
      this.positionSavedAt = clock;
    }
  }

  perform(action: Action, now = Date.now()): Result {
    if (this.save.hasReceipt(action.id)) {
      return reply(action, false, "DUPLICATE", "这次行动已处理。");
    }
    const resident = residents.get(action.target);
    const resource = resources.get(action.target);
    const target =
      resident ??
      resource ??
      [bridge, valley.ruin].find((entry) => entry.id === action.target);
    if (!target)
      return reply(action, false, "UNKNOWN_TARGET", "找不到这个交互对象。");
    if (distance(this.state.player, target) > target.range) {
      return reply(action, false, "TOO_FAR", "再走近一些就能交互。");
    }
    const next = structuredClone(this.state);
    if (resident && action.verb === "inspect")
      return reply(action, true, "INTRO", resident.intro);
    if (resource && action.verb === "collect") {
      const remaining = (next.cooldowns[resource.id] ?? 0) - now;
      if (remaining > 0)
        return reply(
          action,
          false,
          "COOLDOWN",
          `采集点还需 ${Math.ceil(remaining / 1000)} 秒恢复。`,
        );
      if (
        next.inventory[resource.item] + resource.yieldCount >
        inventoryLimit
      ) {
        return reply(action, false, "BAG_FULL", "背包里这一类材料已满。");
      }
      next.inventory[resource.item] += resource.yieldCount;
      next.cooldowns[resource.id] = now + resource.cooldownMs;
      this.commit(next, action.id);
      return reply(
        action,
        true,
        "COLLECTED",
        `获得 ${items[resource.item]} ×${resource.yieldCount}，已放入背包。`,
      );
    }
    if (target.id === bridge.id) return this.bridgeAction(action, next);
    if (target.id === valley.ruin.id && action.verb === "inspect") {
      if (!next.bridge.repaired)
        return reply(action, false, "BRIDGE_CLOSED", "先修好旧桥。");
      if (!next.explored) {
        next.explored = true;
        this.commit(next, action.id);
      }
      return reply(action, true, "RUIN", valley.ruin.clue);
    }
    return reply(action, false, "INVALID_ACTION", "这里无法执行该行动。");
  }

  reset(action: Extract<ClientMessage, { type: "reset" }>): Result {
    if (this.save.hasReceipt(action.id)) {
      return {
        type: "result",
        id: action.id,
        ok: false,
        code: "DUPLICATE",
        text: "这次重开已处理。",
      };
    }
    const state = freshState();
    this.save.write(state, action.id);
    this.state = state;
    this.dirty = false;
    this.halt();
    return {
      type: "result",
      id: action.id,
      ok: true,
      code: "RESET",
      text: "新的旅程开始了。",
    };
  }

  halt() {
    this.intent = { dx: 0, dy: 0, expires: 0 };
    this.working = false;
    this.moving = false;
  }

  flush() {
    if (this.dirty) this.commit(this.state);
  }

  private commit(next: SaveState, receipt?: string) {
    this.save.write(next, receipt);
    this.state = next;
    this.dirty = false;
  }

  private bridgeAction(action: Action, next: SaveState): Result {
    const built = next.bridge;
    const remainingWood = bridge.required.wood - built.wood;
    const remainingStone = bridge.required.stone - built.stone;
    if (action.verb === "inspect") {
      if (!built.discovered) {
        built.discovered = true;
        this.commit(next, action.id);
      }
      return reply(
        action,
        true,
        "BRIDGE",
        built.repaired
          ? "桥面已经整固，可以去东岸了。"
          : `旧桥需要木材 ${bridge.required.wood}、石材 ${bridge.required.stone}。交齐材料后就能施工。`,
      );
    }
    if (built.repaired)
      return reply(action, false, "BRIDGE_DONE", "旧桥已经修好。");
    if (action.verb === "deliver") {
      if (!remainingWood && !remainingStone)
        return reply(
          action,
          false,
          "MATERIALS_READY",
          "材料已交齐，可以施工。",
        );
      if (
        next.inventory.wood < remainingWood ||
        next.inventory.stone < remainingStone
      ) {
        return reply(
          action,
          false,
          "MATERIALS_MISSING",
          `材料不足。还需要木材 ×${remainingWood}、石材 ×${remainingStone}。`,
        );
      }
      next.inventory.wood -= remainingWood;
      next.inventory.stone -= remainingStone;
      built.wood += remainingWood;
      built.stone += remainingStone;
      built.discovered = true;
      this.commit(next, action.id);
      return reply(
        action,
        true,
        "DELIVERED",
        "材料已放到工地。留在桥边开始施工。",
      );
    }
    if (action.verb === "work") {
      if (remainingWood || remainingStone)
        return reply(
          action,
          false,
          "MATERIALS_MISSING",
          "先把木材和石材交到工地。",
        );
      if (this.working)
        return reply(
          action,
          false,
          "ALREADY_WORKING",
          "正在施工，请留在桥边。",
        );
      if (this.moving)
        return reply(action, false, "MOVING", "站稳后再开始施工。");
      this.commit(next, action.id);
      this.halt();
      this.working = true;
      return reply(
        action,
        true,
        "WORK_STARTED",
        "正在铺设桥板。移动会暂停施工，已完成的进度会保留。",
      );
    }
    if (action.verb === "stop") {
      if (!this.working)
        return reply(action, false, "NOT_WORKING", "现在没有进行中的施工。");
      this.commit(next, action.id);
      this.working = false;
      return reply(action, true, "WORK_STOPPED", "已暂停施工，进度已保存。");
    }
    return reply(action, false, "INVALID_ACTION", "这里无法执行该行动。");
  }
}
import { existsSync, mkdirSync, statSync } from "node:fs";
import { dirname } from "node:path";
import { DatabaseSync } from "node:sqlite";
import {
  saveSchema,
  schemaVersion,
  type SaveState,
} from "../shared/protocol.js";
import { isPassable, resources, valley } from "../shared/world.js";

export function freshState(): SaveState {
  return {
    schemaVersion,
    contentVersion: valley.contentVersion,
    worldId: valley.id,
    player: { x: valley.spawn.x, y: valley.spawn.y, facing: "down" },
    inventory: { wood: 0, stone: 0, food: 0, toolbox: 0 },
    cooldowns: {},
    bridge: {
      discovered: false,
      wood: 0,
      stone: 0,
      progressMs: 0,
      repaired: false,
    },
    explored: false,
  };
}

function decode(payload: string): SaveState {
  const save = saveSchema.parse(JSON.parse(payload));
  const bridge = save.bridge;
  const full =
    bridge.wood === valley.bridge.required.wood &&
    bridge.stone === valley.bridge.required.stone;
  if (
    !isPassable(save.player.x, save.player.y, bridge.repaired) ||
    Object.keys(save.cooldowns).some((id) => !resources.has(id)) ||
    (!bridge.discovered && (bridge.wood !== 0 || bridge.stone !== 0)) ||
    (!full && bridge.progressMs !== 0) ||
    bridge.repaired !== (bridge.progressMs === valley.bridge.workMs) ||
    (save.explored && !bridge.repaired)
  ) {
    throw Error("存档内容与地图或工程规则不一致");
  }
  return save;
}

export class SaveFile {
  readonly initial: SaveState;
  private readonly db: DatabaseSync;
  private revision: number;

  constructor(path: string) {
    const existing = path !== ":memory:" && existsSync(path);
    if (existing && statSync(path).size === 0)
      throw Error("现有 SQLite 存档为空");
    if (path !== ":memory:") mkdirSync(dirname(path), { recursive: true });
    this.db = new DatabaseSync(path);
    try {
      this.db.exec("PRAGMA busy_timeout = 1500");
      if (!existing) {
        this.transaction(() => {
          this.db.exec(`
          CREATE TABLE world (
            slot INTEGER PRIMARY KEY CHECK(slot = 1),
            revision INTEGER NOT NULL,
            payload TEXT NOT NULL
          ) STRICT;
          CREATE TABLE receipts (id TEXT PRIMARY KEY) STRICT;
          PRAGMA user_version = ${schemaVersion};
          `);
          this.db
            .prepare("INSERT INTO world VALUES (1, 0, ?)")
            .run(JSON.stringify(freshState()));
        });
      }
      const integrity = this.db
        .prepare("PRAGMA quick_check")
        .get()?.quick_check;
      if (integrity !== "ok") throw Error("SQLite 完整性检查失败");
      if (
        this.db.prepare("PRAGMA user_version").get()?.user_version !==
        schemaVersion
      ) {
        throw Error("SQLite 存档版本不受支持");
      }
      const row = this.db
        .prepare("SELECT revision, payload FROM world WHERE slot = 1")
        .get();
      if (
        !row ||
        typeof row.payload !== "string" ||
        typeof row.revision !== "number" ||
        !Number.isSafeInteger(row.revision) ||
        row.revision < 0
      )
        throw Error("找不到有效的单人存档");
      this.db.prepare("SELECT id FROM receipts LIMIT 1").get();
      this.initial = decode(row.payload);
      this.revision = row.revision;
    } catch (error) {
      this.db.close();
      throw error;
    }
  }

  hasReceipt(id: string) {
    return Boolean(
      this.db.prepare("SELECT 1 FROM receipts WHERE id = ?").get(id),
    );
  }

  write(state: SaveState, receipt?: string) {
    this.transaction(() => {
      const change = this.db
        .prepare(
          "UPDATE world SET revision = revision + 1, payload = ? WHERE slot = 1 AND revision = ?",
        )
        .run(JSON.stringify(state), this.revision);
      if (change.changes !== 1) throw Error("存档已由另一个服务修改");
      if (receipt)
        this.db.prepare("INSERT INTO receipts VALUES (?)").run(receipt);
    });
    this.revision++;
  }

  close() {
    this.db.close();
  }

  private transaction(operation: () => void) {
    this.db.exec("BEGIN IMMEDIATE");
    try {
      operation();
      this.db.exec("COMMIT");
    } catch (error) {
      this.db.exec("ROLLBACK");
      throw error;
    }
  }
}
import Fastify from "fastify";
import fastifyStatic from "@fastify/static";
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { WebSocket, WebSocketServer } from "ws";
import {
  clientMessage,
  schemaVersion,
  type ServerMessage,
} from "../shared/protocol.js";
import { tickMs, valley } from "../shared/world.js";
import { SaveFile } from "./save.js";
import { World } from "./world.js";
import { DialogueSession } from "./dialogue/session.js";

export function createApp(
  options: {
    savePath?: string;
    staticRoot?: string;
    dialogueEnv?: NodeJS.ProcessEnv;
  } = {},
) {
  const app = Fastify({ logger: false });
  const staticRoot = options.staticRoot ?? resolve("release/client");
  if (existsSync(staticRoot)) app.register(fastifyStatic, { root: staticRoot });

  let save: SaveFile | undefined;
  let world: World | undefined;
  let unavailable: string | undefined;
  const savePath = options.savePath ?? resolve("saves/foglamp-valley.sqlite");
  try {
    save = new SaveFile(savePath);
    world = new World(save);
  } catch (error) {
    console.error("存档无法打开，已保留原件。", error);
    unavailable = "存档无法打开。请保留原件并检查 SQLite 文件与存档版本。";
  }

  app.get("/health", (_request, reply) => {
    const info = {
      phase: 2,
      schemaVersion,
      contentVersion: valley.contentVersion,
    };
    reply.header("Cache-Control", "no-store");
    if (unavailable)
      return reply
        .code(503)
        .send({ ...info, status: "save_error", message: unavailable });
    return { ...info, status: "ok" };
  });

  const ws = new WebSocketServer({ noServer: true, maxPayload: 8192 });
  let active: WebSocket | undefined;
  let paused = false;
  let lastPing = 0;
  let answered = true;
  let lastTick = performance.now();
  let lastSent = 0;
  let wasMoving = false;
  let wasWorking = false;

  function send(socket: WebSocket, message: ServerMessage) {
    if (socket.readyState !== WebSocket.OPEN) return;
    if (socket.bufferedAmount > 65536) {
      socket.terminate();
      return;
    }
    socket.send(JSON.stringify(message));
  }

  const dialogue = new DialogueSession(
    savePath === ":memory:" ? savePath : `${savePath}.llm.sqlite`,
    (socket) => {
      if (
        active !== socket ||
        socket.readyState !== WebSocket.OPEN ||
        paused ||
        !world ||
        unavailable
      )
        return;
      const near = world.canTalkToCenyan();
      return { near, bridge: near ? world.publicBridge() : undefined };
    },
    send,
    options.dialogueEnv,
    () => world?.halt(),
  );

  function storageError(error: unknown) {
    console.error("存档写入失败。", error);
    unavailable = "存档写入失败。请检查磁盘与存档，再重新启动服务。";
    world?.halt();
    dialogue.cancel("存档不可用，对话已结束。");
