import datetime
import json
import os
from pathlib import Path
import subprocess
import tempfile

root = Path.cwd()
evidence = root / \"evidence/phase1/final-checks\"
results = []
tz = datetime.timezone(datetime.timedelta(hours=8))

def run(command, filename, env=None, timeout=300):
    start = datetime.datetime.now(tz).isoformat()
    log = evidence / filename
    with log.open(\"w\") as output:
        try:
            code = subprocess.run(command, env=env, stdout=output,
                                  stderr=subprocess.STDOUT, timeout=timeout).returncode
        except subprocess.TimeoutExpired:
            code = 124
            print(f\"Timed out after {timeout}s\", file=output)
    result = {\"command\": \" \".join(command), \"exitCode\": code, \"startedAt\": start,
              \"log\": str(log.relative_to(root))}
    results.append(result)
    (evidence / \"command-results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")
    print(result, flush=True)

