function reachable(repaired: boolean) {
  const step = 8;
  const offset = 4;
  const cols = mapWidth / step;
  const rows = mapHeight / step;
  const start = Math.floor(valley.spawn.y / step) * cols + Math.floor(valley.spawn.x / step);
  const queue = [start];
  const visited = new Set(queue);
  for (let i = 0; i < queue.length; i++) {
    const current = queue[i];
    const column = current % cols;
    const row = Math.floor(current / cols);
    for (const [x, y] of [[column - 1, row], [column + 1, row], [column, row - 1], [column, row + 1]]) {
      const index = y * cols + x;
      if (x < 0 || x >= cols || y < 0 || y >= rows || visited.has(index)) continue;
      if ("'!isPassable(x * step + offset, y * step + offset, repaired) ||
          !isPassable((x + column) * step / 2 + offset, (y + row) * step / 2 + offset, repaired)) continue;
      visited.add(index);
      queue.push(index);
    }
  }
  return queue.map((index) => ({ x: index % cols * step + offset, y: Math.floor(index / cols) * step + offset }));
}

