    for asset in rebuilt[\"assets\"][:-1]:
        relative = asset[\"outputPath\"]
        assert digest(copy / relative) == digest(root / relative) == asset[\"sha256\"], relative
    subprocess.run([sys.executable, str(copy / \"scripts/world/generate.py\")], check=True)
    assert digest(copy / protected[0]) == digest(root / protected[0])
    print(\"Repeatable: all original asset recipes, untouched world and animation data, manifest extensions, deterministic world regeneration.\")
