test("four-way walk frames, pause, a following camera and opt-in music", async ({ page }) => {
  await page.goto("/");
  await ready(page);
  const stage = page.locator("#game");
  for (const [key, axis, sign, facing, column] of [
    ["d", "x", 1, "right", 3], ["s", "y", 1, "down", 0],
    ["a", "x", -1, "left", 2], ["w", "y", -1, "up", 1],
  ] as const) {
    const before = (await position(page))[axis];
    await page.keyboard.down(key);
    try {
      await expect.poll(async () => ((await position(page))[axis] - before) * sign).toBeGreaterThan(12);
      await expect(stage).toHaveAttribute("data-direction", facing);
      await expect(stage).toHaveAttribute("data-moving", "true");
      const frame = Number(await stage.getAttribute("data-frame"));
      expect(frame % 4).toBe(column);
      await expect.poll(async () => Number(await stage.getAttribute("data-frame"))).not.toBe(frame);
    } finally { await page.keyboard.up(key); }
    await waitStill(page);
    await expect(stage).toHaveAttribute("data-frame", String(column));
  }
  await page.keyboard.press("Escape");
  await expect(page.locator("#screen-title")).toHaveText("旅程暂停");
  const paused = await position(page);
  await page.keyboard.down("d");
  await page.waitForTimeout(250);
  await page.keyboard.up("d");
  expect(await position(page)).toEqual(paused);
  await page.keyboard.press("Escape");
  await approach(page, valley.bridge);
  await expect.poll(async () => Number(await stage.getAttribute("data-camera-x"))).toBeGreaterThan(100);
  const cameraX = Number(await stage.getAttribute("data-camera-x"));
  const viewWidth = await page.locator("canvas").evaluate((element: HTMLCanvasElement) => element.width);
  expect(cameraX + viewWidth).toBeLessThanOrEqual(mapWidth + 1);
  await page.getByRole("button", { name: "音乐关" }).click();
  await expect(page.getByRole("button", { name: "音乐开" })).toHaveAttribute("aria-pressed", "true");
  await page.getByRole("button", { name: "音乐开" }).click();
  await expect(page.getByRole("button", { name: "音乐关" })).toHaveAttribute("aria-pressed", "false");
});

test("390px narrow window renders the scene, residents and touch controls", async ({ browser, baseURL }) => {
  const context = await browser.newContext({ baseURL, viewport: { width: 390, height: 844 }, isMobile: true, hasTouch: true });
  try {
    const page = await context.newPage();
    await page.goto("/");
    await ready(page);
    await expect(page.locator("canvas")).toBeVisible();
    await expect(page.locator("#residents img")).toHaveCount(3);
    await expect(page.getByRole("button", { name: "向右" })).toBeVisible();
    expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true);
    await screenshot(page, "scene-narrow");
  } finally { await context.close(); }
});

test("missing bridge art blocks readiness with a clear error", async ({ page }) => {
  await page.route("**/assets/bridge-open.png", (request) => request.fulfill({ status: 404, body: "asset removed by test" }));
  await page.goto("/");
  await expect(page.locator("#screen-title")).toHaveText("游戏素材加载失败");
  await expect(page.locator("#screen-detail")).toContainText("bridge-open");
  await expect(page.locator("#game")).toHaveAttribute("data-ready", "false");
  await expect(page.locator("#interact")).toBeDisabled();
  await screenshot(page, "asset-failure");
});

test("HTTP failure stays unavailable and automatically recovers", async ({ page }) => {
  await page.route("**/health", (request) => request.fulfill({ status: 502, body: "backend unavailable" }));
  await page.goto("/");
  await expect(page.locator("#screen-detail")).toContainText("HTTP 服务无法连接");
  await expect(page.locator("#game")).toHaveAttribute("data-ready", "false");
  await page.unroute("**/health");
  await ready(page);
});

test("WebSocket handshake failure remains visible and prevents input", async ({ page }) => {
  await page.routeWebSocket("**/ws", (socket) => socket.close({ code: 1011, reason: "offline test" }));
  await page.goto("/");
  await expect(page.locator("#screen-detail")).toContainText("WebSocket 连接失败");
  await expect(page.locator("#game")).toHaveAttribute("data-ready", "false");
  await expect(page.locator("#interact")).toBeDisabled();
});

test("the real server rejects augmented movement and out-of-range actions", async () => {
  const socket = new WebSocket("ws://127.0.0.1:3003/ws");
  const messages: Array<{ type: string; code?: string; state?: { player: Point } }> = [];
  socket.on("message", (raw) => messages.push(JSON.parse(raw.toString())));
  try {
    await once(socket, "open");
    await expect.poll(() => messages[0]?.type).toBe("snapshot");
    socket.send(JSON.stringify({ type: "move", dx: 1, dy: 0, x: 654, y: 303, timestamp: Date.now() }));
    await expect.poll(() => messages.find((m) => m.code === "INVALID_MESSAGE")?.type).toBe("error");
    socket.send(JSON.stringify({ type: "action", id: randomUUID(), target: valley.ruin.id, verb: "inspect" }));
    await expect.poll(() => messages.find((m) => m.code === "TOO_FAR")?.type).toBe("result");
    for (const message of messages.filter((m) => m.type === "snapshot")) {
      expect(message.state?.player).toMatchObject({ x: valley.spawn.x, y: valley.spawn.y });
    }
  } finally { socket.terminate(); }
});
