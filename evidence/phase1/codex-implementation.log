import assert from \"node:assert/strict\";
import { readFileSync } from \"node:fs\";
import { createHash } from \"node:crypto\";
import { createApp } from \"./release/server/src/server/app.js\";
const manifest = JSON.parse(readFileSync(\"assets/manifest.json\", \"utf8\"));
const app = createApp({ savePath: \":memory:\" });
const sha = bytes => createHash(\"sha256\").update(bytes).digest(\"hex\");
try {
  const health = await app.inject(\"/health\");
  assert.equal(health.statusCode, 200);
  assert.equal(health.json().status, \"ok\");
  const index = await app.inject(\"/\");
  assert.equal(index.statusCode, 200);
  assert.match(index.body, /雾海行纪/);
  for (const [, file] of index.body.matchAll(/(?:src|href)=\"(\\/assets\\/index-["'^"]+)"/g)) {
    const response = await app.inject(file);
    assert.equal(response.statusCode, 200);
    console.log("Compiled entry", file, response.rawPayload.length);
  }
  for (const asset of manifest.assets) {
    const response = await app.inject(`/assets/${asset.assetId}`);
    assert.equal(response.statusCode, 200, asset.assetId);
    assert.equal(sha(response.rawPayload), asset.sha256, asset.assetId);
  }
  console.log(`Compiled Fastify inject served the entry page and all ${manifest.assets.length} registered local assets; Node environment has only PATH.`);
} finally {
  await app.close();
}
