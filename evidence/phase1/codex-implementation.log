from zipfile import ZipFile
import hashlib, json, shutil, subprocess, sys, tempfile
root = Path.cwd()
source = \"assets/source/ninja-adventure-2026-03-29.zip\"
protected = [\"data/foglamp-valley.json\", \"data/animations.json\", \"data/preview-map.json\"]
def digest(path): return hashlib.sha256(path.read_bytes()).hexdigest()
with ZipFile(source) as archive:
    readme = archive.read(\"Ninja Adventure - Asset Pack/README.md\").decode(\"utf-8\")
    assert \"CC0\" in readme
    print(\"Pinned original README confirms CC0.\")
with tempfile.TemporaryDirectory(prefix=\"mistsea-rebuild-\") as temporary:
    copy = Path(temporary)
    for relative in [\"assets/manifest.json\", *protected, \"scripts/assets/prepare.py\",
                     \"scripts/world/generate.py\"]:
        path = copy / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(root / relative, path)
    link = copy / source
    link.parent.mkdir(parents=True, exist_ok=True)
    link.symlink_to(root / source)
    manifest = copy / \"assets/manifest.json\"
    data = json.loads(manifest.read_text())
    extension = {\"assetId\": \"extension-test.png\", \"outputPath\": \"public/assets/extension-test.png\",
                 \"extensionMemo\": \"keep this out-of-recipe record\"}
    data[\"assets\"].append(extension)
    data[\"assets\"][0][\"extensionMemo\"] = \"keep custom fields on known records\"
    manifest.write_text(json.dumps(data))
    subprocess.run([sys.executable, str(copy / \"scripts/assets/prepare.py\")], check=True)
    rebuilt = json.loads(manifest.read_text())
    assert rebuilt[\"assets\"][-1] == extension
    assert rebuilt[\"assets\"][0][\"extensionMemo\"] == \"keep custom fields on known records\"
    for relative in protected:
