import { test as base, expect, type Page } from \"@playwright/test\";
import { spawn, type ChildProcess } from \"node:child_process\";
import { randomUUID } from \"node:crypto\";
import { once } from \"node:events\";
import { createWriteStream, mkdirSync, mkdtempSync, rmSync } from \"node:fs\";
import { tmpdir } from \"node:os\";
import { join } from \"node:path\";
import { WebSocket } from \"ws\";
import { distance, nearbyTarget, mapWidth, speed, valley, type Point, type Target } from \"../src/shared/world.js\";
import { route } from \"./paths.js\";

const evidence = process.env.MISTSEA_EVIDENCE ?? \"evidence/phase1\";
const backendUrl = \"http://127.0.0.1:3003\";

const test = base.extend<{ backend: { start: () => Promise<void>; stop: () => Promise<void> } }>({
  backend: [async ({}, use, info) => {
    mkdirSync(evidence, { recursive: true });
    const directory = mkdtempSync(join(tmpdir(), \"mistsea-browser-\"));
    const log = createWriteStream(join(evidence, "'`e2e-service-${info.titlePath[0].replace(/[''^a-zA-Z0-9]+/g, "-")}.log`));
    let child: ChildProcess | undefined;
    async function start() {
      child = spawn(process.execPath, ["--import", "tsx", "src/server/index.ts"], {
        env: { ...process.env, HOST: "127.0.0.1", PORT: "3003", MISTSEA_SAVE: join(directory, "valley.sqlite") },
        stdio: ["ignore", "pipe", "pipe"],
      });
      child.stdout!.pipe(log, { end: false });
      child.stderr!.pipe(log, { end: false });
      await expect.poll(async () => {
        if (child?.exitCode !== null) throw Error(`Backend exited: ${child?.exitCode}`);
        try { return (await fetch(`${backendUrl}/health`)).status; } catch { return 0; }
      }, { timeout: 8000 }).toBe(200);
    }
    async function stop() {
      if (child && child.exitCode === null && child.signalCode === null) {
        const exit = once(child, "exit");
        child.kill("SIGTERM");
        await exit;
      }
      child = undefined;
    }
    try {
      await start();
      await use({ start, stop });
    } finally {
      await stop();
      log.end();
      await once(log, "finish");
      rmSync(directory, { recursive: true, force: true });
    }
  }, { auto: true }],
});

const ready = (page: Page) => expect(page.locator("#game")).toHaveAttribute("data-ready", "true", { timeout: 12000 });
const bag = (page: Page, item: string) => page.locator(`[data-item="${item}"]`);
const progress = (page: Page) => page.locator("#progress").evaluate((el: HTMLProgressElement) => el.value);
const position = (page: Page) => page.locator("#game").evaluate((el) => ({ x: Number(el.dataset.x), y: Number(el.dataset.y) }));
const screenshot = (page: Page, basename: string) => page.screenshot({ path: join(evidence, `${basename}.png`), fullPage: true });

async function waitStill(page: Page) {
  await expect(page.locator("#game")).toHaveAttribute("data-moving", "false");
}

async function walk(page: Page, goal: (p: Point) => boolean, repaired = false) {
  const steps = route(await position(page), goal, repaired);
  for (const step of steps) {
    const axis = step.axis;
    const value = step[axis];
    const current = (await position(page))[axis];
    let sign = Math.sign(value - current);
    if (Math.abs(value - current) <= 2) continue;
    const key = axis === "x" ? (sign > 0 ? "d" : "a") : (sign > 0 ? "s" : "w");
    await page.keyboard.down(key);
    try {
      await page.waitForFunction(({ axis, value, sign }) => {
        const current = Number(document.getElementById("game")!.dataset[axis]);
        return (current - value) * sign >= -1.7;
      }, { axis, value, sign }, { timeout: 2200 + Math.abs(value - current) * 1000 / speed });
    } finally {
      await page.keyboard.up(key);
    }
  }
  await waitStill(page);
}

async function approach(page: Page, target: Target, repaired = false) {
  await walk(page, (p) => distance(p, target) <= target.range - 8 && nearbyTarget(p)?.id === target.id, repaired);
  expect(distance(await position(page), target)).toBeLessThan(target.range);
  await expect(page.locator("#target")).toHaveText(target.name);
}

test("fresh journey collects all materials, repairs, crosses, explores and restores", async ({ page, backend }) => {
  const external: string[] = [];
  const errors: string[] = [];
  const initialMissing: string[] = [];
  let restarting = false;
  page.on("request", (request) => {
    const url = new URL(request.url());
    if (url.origin !== "http://127.0.0.1:5174" && url.protocol !== "data:") external.push(request.url());
  });
  page.on("pageerror", (error) => errors.push(error.message));
  page.on("console", (message) => {
    if (message.type() === "error" && !restarting) errors.push(message.text());
  });
  page.on("response", (response) => {
    if (response.status() >= 400 && !restarting) initialMissing.push(response.url());
  });
  await page.goto("/");
  await ready(page);
  await expect(bag(page, "wood")).toHaveText("0");
  await expect(bag(page, "stone")).toHaveText("0");
  await expect(page.locator("#music")).toHaveAttribute("aria-pressed", "false");
  await expect(page.locator("canvas")).toBeVisible();
  const colors = await page.locator("canvas").evaluate((canvas: HTMLCanvasElement) => {
