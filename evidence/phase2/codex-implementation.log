export type Scenario =
  "idle" | "movement" | "construction" | "dialogue-pending";
export type MockUi = {
  input: string;
  send: string;
  pending: string;
  mockBadge: string;
  delayEnv: string;
};

export async function probeRenderer(browser: Browser) {
  const page = await browser.newPage({ viewport });
  // tsx preserves nested function names with an esbuild helper absent in browser realms.
  await page.evaluate("globalThis.__name = (fn) => fn");
  try {
    const contexts = await page.evaluate(() => {
      const canvas = () => document.createElement("canvas");
      const webgl = (
        gl: WebGLRenderingContext | WebGL2RenderingContext | null,
      ) => {
        if (!gl) return null;
        const info = gl.getExtension("WEBGL_debug_renderer_info");
        return {
          version: gl.getParameter(gl.VERSION) as string,
          renderer: gl.getParameter(gl.RENDERER) as string,
          unmaskedRenderer: info
            ? (gl.getParameter(info.UNMASKED_RENDERER_WEBGL) as string)
            : null,
        };
      };
      return {
        canvas2d: Boolean(canvas().getContext("2d")),
        webgl: webgl(canvas().getContext("webgl")),
        experimentalWebgl: webgl(
          canvas().getContext(
            "experimental-webgl",
          ) as WebGLRenderingContext | null,
        ),
        webgl2: webgl(canvas().getContext("webgl2")),
      };
    });
    const session = await browser.newBrowserCDPSession();
    try {
      const { gpu } = await session.send("SystemInfo.getInfo");
      return {
        contexts,
        devices: gpu.devices,
        featureStatus: gpu.featureStatus,
      };
    } finally {
      await session.detach();
    }
  } finally {
    await page.close();
  }
}

type Renderer = {
  type: string;
  version?: string;
  unmaskedRenderer?: string | null;
};
declare global {
  interface Window {
    mistseaPerformanceContext?: (
      canvas: HTMLCanvasElement,
    ) => Renderer | undefined;
  }
}

export async function observeGameCanvas(page: Page) {
  await page.addInitScript("globalThis.__name = (fn) => fn;(" + (() => {
    const contexts = new WeakMap<
      HTMLCanvasElement,
      { kind: string; context: RenderingContext }
    >();
    const getContext = HTMLCanvasElement.prototype.getContext;
    HTMLCanvasElement.prototype.getContext = function (
      this: HTMLCanvasElement,
      kind: string,
      attributes?: unknown,
    ) {
      const context = Reflect.apply(getContext, this, [
        kind,
        attributes,
      ]) as RenderingContext | null;
      if (context) contexts.set(this, { kind, context });
      return context;
    } as typeof getContext;
    window.mistseaPerformanceContext = (canvas) => {
      const entry = contexts.get(canvas);
      if (!entry) return;
      if (!("getParameter" in entry.context)) return { type: entry.kind };
      const gl = entry.context;
      const info = gl.getExtension("WEBGL_debug_renderer_info");
      if (gl.isContextLost()) throw Error("The game's WebGL context was lost.");
      return {
        type: entry.kind,
        version: gl.getParameter(gl.VERSION) as string,
        unmaskedRenderer: info
          ? (gl.getParameter(info.UNMASKED_RENDERER_WEBGL) as string)
          : null,
      };
    };
  }).toString() + ")();");
}

const position = (page: Page) =>
  page
    .locator("#game")
    .evaluate((el) => ({ x: Number(el.dataset.x), y: Number(el.dataset.y) }));

async function approachCenyan(page: Page) {
  const resident = valley.residents.find(({ id }) => id === "cenyan");
  if (!resident) throw Error("Cenyan is missing from the map.");
  const steps = route(
    await position(page),
    (point) =>
      distance(point, resident) <= resident.range - 8 &&
      nearbyTarget(point)?.id === resident.id,
    false,
  );
  for (const step of steps) {
    const { axis } = step;
    const delta = step[axis] - (await position(page))[axis];
    if (Math.abs(delta) <= 2) continue;
    const sign = Math.sign(delta);
    const key = axis === "x" ? (sign > 0 ? "d" : "a") : sign > 0 ? "s" : "w";
import { existsSync, mkdirSync } from "node:fs";
import { dirname } from "node:path";
import { DatabaseSync } from "node:sqlite";
import { npcId, sessionMs, type DialogueConfig } from "./config.js";
import type { Usage } from "./provider.js";

const nanoPerUsd = 1_000_000_000;

function cost(config: DialogueConfig, input: number, output: number) {
  if (!config.prices) return null;
  return Math.ceil(input * config.prices.input + output * config.prices.output);
}

export class DialogueLedger {
  private readonly db: DatabaseSync;

  constructor(path: string) {
    const existing = path !== ":memory:" && existsSync(path);
    if (path !== ":memory:") mkdirSync(dirname(path), { recursive: true });
    this.db = new DatabaseSync(path);
    try {
      // A locked or damaged ledger disables dialogue without delaying gameplay.
      this.db.exec("PRAGMA busy_timeout = 0");
      if (!existing)
        this.transaction(() =>
          this.db.exec(`
        CREATE TABLE calls (
          id TEXT PRIMARY KEY, at_ms INTEGER NOT NULL, npc TEXT NOT NULL,
          mode TEXT NOT NULL, model TEXT NOT NULL, status TEXT NOT NULL, elapsed_ms INTEGER,
          charged_tokens INTEGER NOT NULL, charged_nano INTEGER, estimated_nano INTEGER, usage TEXT
        ) STRICT;
        CREATE INDEX calls_mode_at ON calls(mode, at_ms);
        PRAGMA user_version = 1;
      `),
        );
      if (
        this.db.prepare("PRAGMA user_version").get()?.user_version !== 1 ||
        this.db.prepare("PRAGMA quick_check").get()?.quick_check !== "ok"
      )
        throw Error("Invalid dialogue ledger");
      this.db
        .prepare(
          "UPDATE calls SET status = 'interrupted' WHERE status = 'pending'",
        )
        .run();
    } catch (error) {
      this.db.close();
      throw error;
    }
  }

  private transaction<T>(fn: () => T): T {
    this.db.exec("BEGIN IMMEDIATE");
    try {
      const value = fn();
      this.db.exec("COMMIT");
      return value;
    } catch (error) {
      this.db.exec("ROLLBACK");
      throw error;
    }
  }

  reserve(
    config: DialogueConfig,
    id: string,
    inputTokens: number,
    now = Date.now(),
  ) {
    const limits = config.limits;
    const output = limits.LLM_MAX_OUTPUT_TOKENS;
    const reservedTokens = inputTokens + output;
    const reservedNano = cost(config, inputTokens, output);
    return this.transaction(() => {
      if (this.db.prepare("SELECT id FROM calls WHERE id = ?").get(id))
        return "duplicate";
      const totals = this.db
        .prepare(
          `
        SELECT count(*) AS requests,
          coalesce(sum(at_ms > ?), 0) AS minute, coalesce(sum(at_ms > ?), 0) AS session,
          coalesce(sum(charged_tokens), 0) AS tokens, coalesce(sum(charged_nano), 0) AS nano,
          count(*) - count(charged_nano) AS unpriced
        FROM calls WHERE mode = ?
      `,
        )
        .get(now - 60_000, now - sessionMs, config.mode)! as Record<
        string,
        number
      >;
      const cap = limits.LLM_MAX_TOTAL_USD;
      if (
        totals.minute >= limits.LLM_MAX_REQUESTS_PER_MINUTE ||
        totals.session >= limits.LLM_MAX_REQUESTS_PER_SESSION ||
        totals.requests >= limits.LLM_MAX_TOTAL_REQUESTS ||
        totals.tokens + reservedTokens > limits.LLM_MAX_TOTAL_TOKENS ||
        (config.mode === "live" &&
          cap !== undefined &&
          (totals.unpriced ||
            reservedNano === null ||
            totals.nano + reservedNano > Math.floor(cap * nanoPerUsd)))
      ) {
        return "budget";
      }
      this.db
        .prepare(
          `
        INSERT INTO calls (id, at_ms, npc, mode, model, status, charged_tokens, charged_nano)
        VALUES (?, ?, ?, ?, ?, 'pending', ?, ?)
      `,
        )
        .run(
          id,
          now,
          npcId,
          config.mode,
          config.model,
          reservedTokens,
          reservedNano,
        );
      return "ok";
    });
  }

  finish(
    config: DialogueConfig,
    id: string,
    status: string,
    elapsedMs: number,
    usage?: Usage,
  ) {
    const subtotal = usage
      ? usage.prompt_tokens + usage.completion_tokens
      : null;
    const actual =
      subtotal === null
        ? null
        : Math.max(subtotal, usage?.total_tokens ?? subtotal);
    // Reasoning and other *_details are recorded subsets. A differing total
    // leaves the allocation of any additional tokens unknown.
    const consistent =
      usage &&
      (usage.total_tokens === undefined || usage.total_tokens === subtotal);
    const estimate = consistent
      ? cost(config, usage.prompt_tokens, usage.completion_tokens)
      : null;
    this.db
      .prepare(
        `
      UPDATE calls
      SET status = ?, elapsed_ms = ?, usage = ?, estimated_nano = ?,
          charged_tokens = CASE WHEN ? THEN coalesce(?, charged_tokens)
                                ELSE max(charged_tokens, coalesce(?, 0)) END,
          charged_nano = CASE WHEN ? THEN ? ELSE charged_nano END
      WHERE id = ? AND status = 'pending'
    `,
      )
      .run(
        status,
        Math.round(elapsedMs),
        usage ? JSON.stringify(usage) : null,
        estimate,
        status === "ok" && consistent ? 1 : 0,
        actual,
        actual,
        status === "ok" && estimate !== null ? 1 : 0,
        estimate,
        id,
      );
  }

  close() {
    this.db.close();
  }
}

