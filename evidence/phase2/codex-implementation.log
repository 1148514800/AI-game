  constructor(path: string, private readonly state: (socket: WebSocket) => State,
              private readonly send: (socket: WebSocket, event: DialogueEvent) => void,
              env?: NodeJS.ProcessEnv) {
    try { this.config = readDialogueConfig(env); }
    catch { this.disable(\"config\"); return; }
    try { this.ledger = new DialogueLedger(path); }
    catch { this.disable(\"ledger\"); }
  }

  private disable(code: \"config\" | \"ledger\") {
    this.unavailable = code;
    console.warn("'`[dialogue] ${code}`);
  }

  private error(owner: WebSocket, requestId: string, code: keyof typeof failures, dialogId?: string) {
    this.send(owner, { type: "dialogue", event: "error", requestId, dialogId, code, text: failures[code] });
  }

  handle(owner: WebSocket, msg: Extract<ClientMessage, { type: `dialogue-${string}` }>) {
    if (msg.type === "dialogue-close") {
      if (this.dlg?.owner === owner && this.dlg.id === msg.dialogId) this.cancel("对话已关闭。", false);
      return;
    }
    const state = this.state(owner);
    const dialogId = msg.type === "dialogue-send" ? msg.dialogId : undefined;
    const fail = (code: keyof typeof failures) => this.error(owner, msg.id, code, dialogId);
    if (!state) return fail("inactive");
    if (msg.type === "dialogue-open" && msg.npc !== npcId) return fail("npc");
    if (!state.near) return fail("distance");
    if (this.unavailable || !this.config || !this.ledger) return fail(this.unavailable ?? "ledger");
    const config = this.config;
    if (msg.type === "dialogue-open") {
      if (this.dlg) this.cancel("旧对话已关闭。", false);
      const id = randomUUID();
      this.dlg = { id, owner, epoch: this.epoch };
      this.send(owner, { type: "dialogue", event: "opened", requestId: msg.id, dialogId: id, mode: config.mode });
      return;
    }
    const dialog = this.dlg;
    if (!dialog || dialog.owner !== owner || dialog.id !== msg.dialogId) return fail("stale");
    if (this.pending?.id === msg.id && this.pending.dialog === dialog) return;
    if (this.pending) return fail("busy");
    const text = msg.text.trim();
    if (!text || text.length > dialogueInputLimit || /['"\\u0000-\\u0008\\u000e-\\u001f]/.test(text))
      return fail(\"invalid_input\");
    const history = this.history.slice();
    const { messages, reservedInputTokens } = buildMessages(state.bridge, history, text);
    try {
      const status = this.ledger.reserve(config, msg.id, reservedInputTokens);
      if (status "'!== "ok") return fail(status);
    } catch {
      this.disable("ledger");
      return fail("ledger");
    }
    const request: Request = { dialog, id: msg.id, abort: new AbortController() };
    this.pending = request;
    this.send(owner, { type: "dialogue", event: "pending", requestId: msg.id, dialogId: dialog.id });
    void this.run(request, config, this.ledger, messages, () => mockReply(state.bridge, history, text), text);
  }

  private async run(request: Request, config: DialogueConfig, ledger: DialogueLedger,
                    messages: ReturnType<typeof buildMessages>["messages"], mock: () => string, player: string) {
    const start = performance.now();
    const { dialog, id, abort } = request;
    let result: Awaited<ReturnType<typeof generate>> | undefined;
    let status = "ok";
    try {
      result = await generate(config, messages, mock, abort.signal);
    } catch (error) {
      status = error instanceof DialogueFailure ? error.code : "provider";
    }
    const current = this.dlg === dialog && this.epoch === dialog.epoch && this.state(dialog.owner)?.near && !abort.signal.aborted;
    if (!current) status = "cancelled";
    try { ledger.finish(config, id, status, performance.now() - start, result?.usage); }
    catch { this.disable("ledger"); status = "ledger"; }
    this.pending = undefined;
    if (!current) return;
    if (status !== "ok" || !result) {
      this.error(dialog.owner, id, status, dialog.id);
      return;
    }
    this.history.push({ player, reply: result.text });
    if (this.history.length > historyTurns) this.history.shift();
    this.send(dialog.owner, { type: "dialogue", event: "reply", requestId: id, dialogId: dialog.id, text: result.text });
  }

  checkDistance() {
    if (this.dlg && !this.state(this.dlg.owner)?.near) this.cancel("已离开交谈范围。");
  }

  cancel(text: string, notify = true) {
    const dialog = this.dlg;
    if (!dialog) return;
    this.dlg = undefined;
    if (this.pending?.dialog === dialog) this.pending.abort.abort();
    if (notify) this.send(dialog.owner, { type: "dialogue", event: "closed", dialogId: dialog.id, text });
  }

  reset() {
    this.cancel("旅程已重开。");
    this.epoch++;
    this.history = [];
  }

  close() {
    this.cancel("服务正在关闭。", false);
    // Cancellation is charged at reservation. The next startup marks any
    // unsettled record interrupted if its async cleanup had no time to run.
    this.ledger?.close();
    this.ledger = undefined;
  }
}
