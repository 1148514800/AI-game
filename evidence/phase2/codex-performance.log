      : "修复雾灯旧桥";
  element("next-step").textContent = state.explored
    ? "你已在东岸找到航标线索，可以继续探索雾灯谷。"
    : built.repaired
      ? "穿过旧桥，顺着东岸小路前往航标遗迹。"
      : working
        ? "正在铺设桥板。留在渡口，直到施工完成。"
        : hasMaterials
          ? "材料已到位。在渡口开始施工。"
          : built.discovered
            ? "北坡林地采木，南坡岩场取石，再回渡口交付。"
            : "向东走到河边，查看雾灯旧桥。";
  document
