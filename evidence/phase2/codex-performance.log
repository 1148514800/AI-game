+  pathToFileURL(join(compiledRoot, "server/save.js")).href
+);
+const { isPassable, nearbyTarget, valley } = await import(
+  pathToFileURL(join(compiledRoot, "shared/world.js")).href
+);
+const state = freshState();
+const bridge = valley.bridge;
+state.player = { x: bridge.x, y: bridge.y, facing: "right" };
+if (!isPassable(bridge.x, bridge.y, false) || nearbyTarget(state.player)?.id !== bridge.id) {
+  throw Error("Construction fixture is outside the playable bridge interaction area.");
+}
+Object.assign(state.bridge, bridge.required, { discovered: true });
+const save = new SaveFile(savePath);
+try {
+  // Benchmark load only: the materials are already on site; the bag stays empty.
+  save.write(state);
+} finally {
+  save.close();
+}
diff --git a/scripts/performance/page.ts b/scripts/performance/page.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4f2f801d8466d96267ae00e95083e2c3f89b4873
--- /dev/null
+++ b/scripts/performance/page.ts
@@ -0,0 +1,339 @@
+import { chromium, expect, type Browser, type Page } from "@playwright/test";
+import { setTimeout as delay } from "node:timers/promises";
+import { route } from "../../tests/paths.js";
+import {
+  distance,
+  nearbyTarget,
+  speed,
+  valley,
+} from "../../src/shared/world.js";
+
+export const viewport = { width: 1280, height: 960 };
+export const durationMs = 5000;
+export const warmupMs = 1000;
+export const mockDelayMs = 8500;
+export const launchOptions = {
+  channel: "chromium",
+  headless: true,
+  chromiumSandbox: true,
+  // This is a default switch in the locked Playwright release.
+  ignoreDefaultArgs: ["--enable-unsafe-swiftshader"],
+  timeout: 7000,
+};
+export const launchBrowser = (env: Record<string, string>) =>
+  chromium.launch({ ...launchOptions, env });
+
+export type Scenario =
+  "idle" | "movement" | "construction" | "dialogue-pending";
+export type MockUi = {
+  input: string;
+  send: string;
+  pending: string;
+  mockBadge: string;
+  delayEnv: string;
+};
+
+export async function probeRenderer(browser: Browser) {
+  const page = await browser.newPage({ viewport });
+  try {
+    const contexts = await page.evaluate(() => {
+      const canvas = () => document.createElement("canvas");
+      const webgl = (
+        gl: WebGLRenderingContext | WebGL2RenderingContext | null,
+      ) => {
+        if (!gl) return null;
+        const info = gl.getExtension("WEBGL_debug_renderer_info");
+        return {
+          version: gl.getParameter(gl.VERSION) as string,
+          renderer: gl.getParameter(gl.RENDERER) as string,
+          unmaskedRenderer: info
+            ? (gl.getParameter(info.UNMASKED_RENDERER_WEBGL) as string)
+            : null,
+        };
+      };
+      return {
+        canvas2d: Boolean(canvas().getContext("2d")),
+        webgl: webgl(canvas().getContext("webgl")),
+        experimentalWebgl: webgl(
+          canvas().getContext(
+            "experimental-webgl",
+          ) as WebGLRenderingContext | null,
+        ),
+        webgl2: webgl(canvas().getContext("webgl2")),
+      };
+    });
+    const session = await browser.newBrowserCDPSession();
+    try {
+      const { gpu } = await session.send("SystemInfo.getInfo");
+      return {
+        contexts,
+        devices: gpu.devices,
+        featureStatus: gpu.featureStatus,
+      };
+    } finally {
+      await session.detach();
+    }
+  } finally {
+    await page.close();
+  }
+}
+
+type Renderer = {
+  type: string;
+  version?: string;
+  unmaskedRenderer?: string | null;
+};
+declare global {
+  interface Window {
+    mistseaPerformanceContext?: (
+      canvas: HTMLCanvasElement,
+    ) => Renderer | undefined;
+  }
+}
+
+export async function observeGameCanvas(page: Page) {
+  await page.addInitScript(() => {
+    const contexts = new WeakMap<
+      HTMLCanvasElement,
+      { kind: string; context: RenderingContext }
+    >();
+    const getContext = HTMLCanvasElement.prototype.getContext;
+    HTMLCanvasElement.prototype.getContext = function (
+      this: HTMLCanvasElement,
+      kind: string,
+      attributes?: unknown,
+    ) {
+      const context = Reflect.apply(getContext, this, [
+        kind,
+        attributes,
+      ]) as RenderingContext | null;
+      if (context) contexts.set(this, { kind, context });
+      return context;
+    } as typeof getContext;
+    window.mistseaPerformanceContext = (canvas) => {
+      const entry = contexts.get(canvas);
+      if (!entry) return;
+      if (!("getParameter" in entry.context)) return { type: entry.kind };
+      const gl = entry.context;
+      const info = gl.getExtension("WEBGL_debug_renderer_info");
+      if (gl.isContextLost()) throw Error("The game's WebGL context was lost.");
+      return {
+        type: entry.kind,
+        version: gl.getParameter(gl.VERSION) as string,
+        unmaskedRenderer: info
+          ? (gl.getParameter(info.UNMASKED_RENDERER_WEBGL) as string)
+          : null,
+      };
+    };
+  });
+}
+
+const position = (page: Page) =>
+  page
+    .locator("#game")
+    .evaluate((el) => ({ x: Number(el.dataset.x), y: Number(el.dataset.y) }));
+
+async function approachCenyan(page: Page) {
+  const resident = valley.residents.find(({ id }) => id === "cenyan");
+  if (!resident) throw Error("Cenyan is missing from the map.");
+  const steps = route(
+    await position(page),
+    (point) =>
+      distance(point, resident) <= resident.range - 8 &&
+      nearbyTarget(point)?.id === resident.id,
+    false,
+  );
+  for (const step of steps) {
+    const { axis } = step;
+    const delta = step[axis] - (await position(page))[axis];
+    if (Math.abs(delta) <= 2) continue;
+    const sign = Math.sign(delta);
+    const key = axis === "x" ? (sign > 0 ? "d" : "a") : sign > 0 ? "s" : "w";
+    await page.keyboard.down(key);
+    try {
+      await page.waitForFunction(
+        ({ axis, target, sign }) => {
+          const current = Number(
+            document.getElementById("game")!.dataset[axis],
+          );
+          return (current - target) * sign >= -1.7;
+        },
+        { axis, target: step[axis], sign },
+        { timeout: 2200 + (Math.abs(delta) * 1000) / speed },
+      );
+    } finally {
+      await page.keyboard.up(key);
+    }
+  }
+  await expect(page.locator("#target")).toHaveText(resident.name);
+  await expect(page.locator("#game")).toHaveAttribute("data-moving", "false");
+}
+
+function captureFrames(page: Page, pendingSelector?: string) {
+  return page.evaluate(
+    ({ duration, pendingSelector }) => {
+      const stage = document.querySelector<HTMLElement>("#game")!;
+      const progress = document.querySelector<HTMLProgressElement>("#progress")!;
+      function state() {
+        const pending = pendingSelector ? document.querySelector(pendingSelector) : null;
+        return {
+          visible: document.visibilityState === "visible",
+          ready: stage.dataset.ready === "true",
+          x: Number(stage.dataset.x),
+          y: Number(stage.dataset.y),
+          moving: stage.dataset.moving === "true",
+          working: stage.dataset.working === "true",
+          progressPercent: progress.value,
+          pending: Boolean(pending?.getClientRects().length && getComputedStyle(pending).visibility === "visible"),
+        };
+      }
+      return new Promise<{
+        startEpochMs: number;
+        endEpochMs: number;
+        frameTimesMs: number[];
+        start: ReturnType<typeof state>;
+        end: ReturnType<typeof state>;
+      }>((resolve, reject) => {
+        const frameTimesMs: number[] = [];
+        let first: number;
+        let previous: number;
+        let start: ReturnType<typeof state>;
+        let request: number;
+        const timer = setTimeout(() => {
+          cancelAnimationFrame(request);
+          reject(
+            Error(
+              "The rendered page did not deliver five seconds of RAF timestamps before timeout.",
+            ),
+          );
+        }, duration + 3000);
+        function frame(timestamp: number) {
+          if (first === undefined) {
+            first = timestamp;
+            start = state();
+          } else {
+            frameTimesMs.push(timestamp - previous);
+          }
+          previous = timestamp;
+          if (timestamp - first < duration) {
+            request = requestAnimationFrame(frame);
+            return;
+          }
+          clearTimeout(timer);
+          resolve({
+            startEpochMs: performance.timeOrigin + first,
+            endEpochMs: performance.timeOrigin + timestamp,
+            frameTimesMs,
+            start,
+            end: state(),
+          });
+        }
+        request = requestAnimationFrame(frame);
+      });
+    },
+    { duration: durationMs, pendingSelector },
+  );
+}
+
+export async function samplePage(
+  page: Page,
+  scenario: Scenario,
+  mockUi?: MockUi,
+) {
+  const stage = page.locator("#game");
+  const canvas = stage.locator("canvas");
+  await expect(stage).toHaveAttribute("data-ready", "true", { timeout: 8000 });
+  await expect(canvas).toBeVisible();
+  const renderer = await canvas.evaluate((el) =>
+    window.mistseaPerformanceContext?.(el as HTMLCanvasElement),
+  );
+  if (!renderer)
+    throw Error("No actual rendering context was observed on the game canvas.");
+  await page.getByRole("button", { name: "音效开", exact: true }).click();
+  if (scenario === "dialogue-pending") await approachCenyan(page);
+  await delay(warmupMs);
+
+  if (scenario === "construction") {
+    await page.getByRole("button", { name: "开始施工" }).click();
+    await expect(stage).toHaveAttribute("data-working", "true");
+  }
+  if (scenario === "dialogue-pending") {
+    if (!mockUi)
+      throw Error("The after run needs a pending Mock UI configuration.");
+    await page.keyboard.press("e");
+    await expect(page.locator(mockUi.mockBadge)).toBeVisible();
+    await page.locator(mockUi.input).fill("岑砚，修旧桥前需要准备什么？");
+    await page.locator(mockUi.send).click();
+    await expect(page.locator(mockUi.pending)).toBeVisible();
+  }
+
+  const movementLegs: number[] = [];
+  let held: "a" | "d" = "d";
+  async function move() {
+    let previous = (await position(page)).x;
+    for (let index = 0; index < 5; index++) {
+      await delay(950);
+      const next = (await position(page)).x;
+      const advanced = (next - previous) * (held === "d" ? 1 : -1);
+      movementLegs.push(advanced);
+      if (advanced < 25)
+        throw Error(`Movement leg ${index + 1} advanced only ${advanced}px.`);
+      previous = next;
+      await page.keyboard.up(held);
+      held = held === "d" ? "a" : "d";
+      await page.keyboard.down(held);
+    }
+  }
+
+  try {
+    if (scenario === "movement") {
+      await page.keyboard.down(held);
+      await expect(stage).toHaveAttribute("data-moving", "true");
+    }
+    const [frames] = await Promise.all([
+      captureFrames(
+        page,
+        scenario === "dialogue-pending" ? mockUi?.pending : undefined,
+      ),
+      scenario === "movement" ? move() : undefined,
+    ]);
+    const { start, end } = frames;
+    if (!start.visible || !end.visible || !start.ready || !end.ready)
+      throw Error(
+        "The page was hidden or disconnected at a sampling boundary.",
+      );
+    if (
+      scenario === "idle" &&
+      (start.moving ||
+        end.moving ||
+        start.working ||
+        end.working ||
+        start.x !== end.x ||
+        start.y !== end.y)
+    )
+      throw Error("The idle scenario did not stay still.");
+    if (
+      scenario === "movement" &&
+      (!start.moving || !end.moving || Math.abs(end.y - start.y) > 0.1)
+    )
+      throw Error(
+        "The horizontal movement scenario was inactive at a sampling boundary.",
+      );
+    if (
+      scenario === "construction" &&
+      (!start.working ||
+        !end.working ||
+        end.progressPercent <= start.progressPercent)
+    )
+      throw Error(
+        "Construction was interrupted or failed to advance during sampling.",
+      );
+    if (scenario === "dialogue-pending" && (!start.pending || !end.pending))
+      throw Error(
+        "The Mock response did not remain pending for the entire sampling window.",
+      );
+    return { renderer, frames, movementLegs };
+  } finally {
+    if (scenario === "movement") await page.keyboard.up(held);
+  }
+}
diff --git a/scripts/performance/run.ts b/scripts/performance/run.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c7b013a564c9f97a9773f224434d7453182b51f8
--- /dev/null
+++ b/scripts/performance/run.ts
@@ -0,0 +1,603 @@
+import { execFile, spawn, type ChildProcess } from "node:child_process";
+import { createHash } from "node:crypto";
+import { once } from "node:events";
+import {
+  appendFileSync,
+  closeSync,
+  cpSync,
+  mkdirSync,
+  mkdtempSync,
+  openSync,
+  readFileSync,
+  readdirSync,
+  rmSync,
+  symlinkSync,
+  writeFileSync,
+} from "node:fs";
+import { arch, cpus, platform, release, tmpdir } from "node:os";
+import { join, relative, resolve } from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import { parseArgs, promisify } from "node:util";
+import type { Browser } from "@playwright/test";
+import {
+  durationMs,
+  launchBrowser,
+  launchOptions,
+  mockDelayMs,
+  observeGameCanvas,
+  probeRenderer,
+  samplePage,
+  viewport,
+  warmupMs,
+  type MockUi,
+  type Scenario,
+} from "./page.js";
+
+const baseline = "62c5c2a10dff3afc18dbe875341f3a274ca3b436";
+const exec = promisify(execFile);
+const repo = resolve(import.meta.dirname, "../..");
+const buildInputs = [
+  "src",
+  "data",
+  "assets/manifest.json",
+  "public",
+  "index.html",
+  "package.json",
+  "package-lock.json",
+  "tsconfig.json",
+  "tsconfig.server.json",
+  "vite.config.ts",
+];
+const scenarios: Scenario[] = [
+  "idle",
+  "movement",
+  "construction",
+  "dialogue-pending",
+];
+const {
+  positionals: [mode, ...extra],
+  values,
+} = parseArgs({
+  allowPositionals: true,
+  options: { "mock-ui": { type: "string" } },
+});
+if (
+  (mode !== "before" && mode !== "after") ||
+  extra.length ||
+  (values["mock-ui"] && mode !== "after")
+) {
+  throw Error(
+    "Usage: node --import tsx scripts/performance/run.ts before|after [--mock-ui path.json]",
+  );
+}
+
+function readMockUi(path: string): MockUi {
+  const config: MockUi = JSON.parse(readFileSync(path, "utf8"));
+  for (const name of [
+    "input",
+    "send",
+    "pending",
+    "mockBadge",
+    "delayEnv",
+  ] as const) {
+    if (typeof config?.[name] !== "string" || !config[name].trim()) {
+      throw Error(`Missing Mock UI configuration field: ${name}`);
+    }
+  }
+  if (!/^(?:[A-Z0-9]+_)*MOCK_(?:[A-Z0-9]+_)*DELAY_MS$/.test(config.delayEnv)) {
+    throw Error("Mock UI delayEnv must name a Mock delay-in-ms setting.");
+  }
+  return config;
+}
+
+const mockUi = values["mock-ui"] ? readMockUi(values["mock-ui"]) : undefined;
+const evidence = join(repo, "evidence/phase2/performance");
+mkdirSync(evidence, { recursive: true });
+const output = mkdtempSync(join(evidence, `${mode}-`));
+// Keep SQLite on the workspace filesystem. The mount is part of the benchmark.
+const temp = mkdtempSync(join(tmpdir(), "mistsea-performance-"));
+const saves = mkdtempSync(join(output, ".temporary-saves-"));
+const home = join(temp, "home");
+mkdirSync(home);
+const toolEnv = { PATH: process.env.PATH ?? "/usr/bin:/bin", HOME: home };
+const gitEnv = {
+  ...toolEnv,
+  GIT_CONFIG_NOSYSTEM: "1",
+  GIT_CONFIG_GLOBAL: "/dev/null",
+};
+const reportPath = join(output, "report.json");
+const logError = (error: unknown) =>
+  error instanceof Error ? error.message : String(error);
+
+const variants =
+  mode === "before"
+    ? [
+        { name: "baseline-canvas", renderer: "original-canvas" },
+        {
+          name: "baseline-webgl-variant",
+          renderer: "webgl-only-source-change",
+        },
+      ]
+    : [{ name: "after-current", renderer: "current-source" }];
+
+type CaseResult = { status: "sampled" | "failed" | "N/A"; reason?: string };
+type VariantResult = (typeof variants)[number] & {
+  status?: "completed" | "failed" | "unavailable";
+  reason?: string;
+  sourceSha256?: string;
+  lockfileSha256?: string;
+  cases: Partial<Record<Scenario, CaseResult>>;
+};
+
+const report = {
+  mode,
+  expectedBaseline: baseline,
+  checkoutHead: "",
+  startedAt: new Date().toISOString(),
+  finishedAt: "",
+  environment: {
+    node: process.version,
+    platform: platform(),
+    kernel: release(),
+    architecture: arch(),
+    cpu: cpus()[0]?.model,
+    logicalCpus: cpus().length,
+    viewport,
+    deviceScaleFactor: 1,
+    chromiumLaunch: launchOptions,
+    build: "production",
+    durationMs,
+    warmupMs,
+    tickPeriodMs: 50,
+    mockDelayMs: mockUi ? mockDelayMs : null,
+    sqliteLocation: "isolated evidence-directory filesystem",
+  },
+  browser: {} as {
+    version?: string;
+    capability?: Awaited<ReturnType<typeof probeRenderer>>;
+    error?: string;
+  },
+  variants: variants.map((variant): VariantResult => ({
+    ...variant,
+    cases: {},
+  })),
+  error: undefined as string | undefined,
+};
+
+function fileHash(path: string) {
+  return createHash("sha256").update(readFileSync(path)).digest("hex");
+}
+
+function sourceHash(root: string) {
+  const hash = createHash("sha256");
+  for (const input of buildInputs) {
+    const absolute = join(root, input);
+    const paths = readdirFiles(absolute);
+    for (const path of paths)
+      hash.update(`${relative(root, path)}\0${fileHash(path)}\n`);
+  }
+  return hash.digest("hex");
+}
+
+function readdirFiles(path: string): string[] {
+  try {
+    return readdirSync(path, { withFileTypes: true })
+      .sort((a, b) => (a.name < b.name ? -1 : a.name === b.name ? 0 : 1))
+      .flatMap((entry) =>
+        entry.isDirectory()
+          ? readdirFiles(join(path, entry.name))
+          : [join(path, entry.name)],
+      );
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOTDIR") return [path];
+    throw error;
+  }
+}
+
+async function build(variant: VariantResult, directory: string) {
+  const root = join(temp, variant.name);
+  mkdirSync(root);
+  const log = openSync(join(directory, "build.log"), "wx");
+  try {
+    if (mode === "before") {
+      const archive = join(temp, `${variant.name}.tar`);
+      await loggedCommand("git", ["archive", `--output=${archive}`, baseline, "--", ...buildInputs], repo, log, 15000, gitEnv);
+      await loggedCommand("tar", ["-xf", archive], root, log, 15000);
+      rmSync(archive);
+    } else {
+      for (const path of buildInputs)
+        cpSync(join(repo, path), join(root, path), { recursive: true });
+    }
+    if (variant.renderer === "webgl-only-source-change") {
+      const entry = join(root, "src/client/main.ts");
+      const source = readFileSync(entry, "utf8");
+      const canvas = "type: Phaser.CANVAS,";
+      if (source.split(canvas).length !== 2)
+        throw Error("Expected exactly one baseline renderer setting.");
+      writeFileSync(entry, source.replace(canvas, "type: Phaser.WEBGL,"));
+    }
+    variant.sourceSha256 = sourceHash(root);
+    variant.lockfileSha256 = fileHash(join(root, "package-lock.json"));
+    if (variant.lockfileSha256 !== fileHash(join(repo, "package-lock.json"))) {
+      throw Error(
+        "Install dependencies matching the sampled source lockfile before running the harness.",
+      );
+    }
+    symlinkSync(join(repo, "node_modules"), join(root, "node_modules"), "dir");
+    for (const [entry, ...args] of [
+      ["node_modules/vite/bin/vite.js", "build", "--outDir", "release/client"],
+      ["node_modules/typescript/bin/tsc", "-p", "tsconfig.server.json"],
+    ]) {
+      await loggedCommand(process.execPath, [entry, ...args], root, log, 30000);
+    }
+    return root;
+  } finally {
+    closeSync(log);
+  }
+}
+
+function deadline<T>(promise: Promise<T>, ms: number, description: string) {
+  let timer: NodeJS.Timeout;
+  const timeout = new Promise<never>((_, reject) => {
+    timer = setTimeout(() => reject(Error(description)), ms);
+  });
+  return Promise.race([promise, timeout]).finally(() => clearTimeout(timer));
+}
+
+let browser: Browser | undefined;
+let activeChild: ChildProcess | undefined;
+let interrupted: NodeJS.Signals | undefined;
+
+function interrupt(signal: NodeJS.Signals) {
+  interrupted = signal;
+  activeChild?.kill("SIGTERM");
+  void browser?.close().catch(() => {});
+}
+process.on("SIGINT", interrupt);
+process.on("SIGTERM", interrupt);
+
+async function stop(child: ChildProcess) {
+  if (child.exitCode !== null || child.signalCode !== null || !child.pid)
+    return;
+  const closed = once(child, "close");
+  child.kill("SIGTERM");
+  try {
+    await deadline(closed, 2500, "Server did not stop on SIGTERM.");
+  } catch {
+    child.kill("SIGKILL");
+    await closed;
+  }
+}
+
+async function loggedCommand(command: string, args: string[], cwd: string, log: number, ms: number, env = toolEnv) {
+  if (interrupted) throw Error(`Interrupted by ${interrupted}.`);
+  const child = spawn(command, args, { cwd, env, stdio: ["ignore", log, log] });
+  activeChild = child;
+  try {
+    const [code, signal] = await deadline(once(child, "close"), ms, `${command} ${args[0]} timed out.`);
+    if (code !== 0) throw Error(`${command} ${args[0]} exited with ${signal ?? code}.`);
+  } finally {
+    await stop(child);
+    activeChild = undefined;
+  }
+}
+
+async function withServer<T>(
+  root: string,
+  directory: string,
+  scenario: Scenario,
+  run: (url: string, child: ChildProcess) => Promise<T>,
+) {
+  const compiled = join(root, "release/server/src");
+  const savePath = join(
+    saves,
+    `${relative(output, directory).replaceAll("/", "-")}-${scenario}.sqlite`,
+  );
+  const serverLog = join(directory, `${scenario}.server.log`);
+  const preload = join(import.meta.dirname, "tick-preload.mjs");
+  if (scenario === "construction") {
+    const log = openSync(serverLog, "wx");
+    try {
+      await loggedCommand(
+        process.execPath,
+        [
+          join(import.meta.dirname, "fixtures/construction.mjs"),
+          compiled,
+          savePath,
+        ],
+        root, log, 5000,
+      );
+    } finally {
+      closeSync(log);
+    }
+  }
+  const env = {
+    ...toolEnv,
+    HOST: "127.0.0.1",
+    PORT: "0",
+    MISTSEA_SAVE: savePath,
+    LLM_ENABLED: "false",
+  };
+  if (scenario === "dialogue-pending" && mockUi)
+    Object.assign(env, { [mockUi.delayEnv]: String(mockDelayMs) });
+  const child = spawn(
+    process.execPath,
+    ["--import", preload, "release/server/src/server/index.js"],
+    {
+      cwd: root,
+      env,
+      stdio: ["ignore", "pipe", "pipe", "ipc"],
+    },
+  );
+  activeChild = child;
+  try {
+    let stdout = "";
+    const address = new Promise<string>((resolve, reject) => {
+      child.once("error", reject);
+      child.once("close", (code, signal) =>
+        reject(
+          Error(
+            `Server stopped before readiness (${signal ?? code}). See ${relative(repo, serverLog)}.`,
+          ),
+        ),
+      );
+      child.stdout!.setEncoding("utf8").on("data", (chunk: string) => {
+        appendFileSync(serverLog, chunk);
+        stdout = (stdout + chunk).slice(-2000);
+        const url = stdout.match(
+          /雾灯谷 · (http:\/\/127\.0\.0\.1:\d+)\r?\n/,
+        )?.[1];
+        if (url) resolve(url);
+      });
+      child.stderr!.on("data", (chunk: Buffer) =>
+        appendFileSync(serverLog, chunk),
+      );
+    });
+    const url = await deadline(
+      address,
+      6000,
+      `No loopback address reported. See ${relative(repo, serverLog)}.`,
+    );
+    const health = await fetch(`${url}/health`, {
+      signal: AbortSignal.timeout(2000),
+    });
+    if (!health.ok || (await health.json()).status !== "ok")
+      throw Error(`Server is unhealthy: HTTP ${health.status}.`);
+    return await run(url, child);
+  } finally {
+    await stop(child);
+    activeChild = undefined;
+  }
+}
+
+type Tick = { registration: number; startEpochMs: number; durationMs: number };
+
+async function readTicks(child: ChildProcess) {
+  const [result] = await deadline(
+    new Promise<[unknown]>((resolve, reject) => {
+      child.once("message", (message) => resolve([message]));
+      child.send("mistsea-performance-ticks", (error) => {
+        if (error) reject(error);
+      });
+    }),
+    2500,
+    "No tick timing received from the server preload.",
+  );
+  const { periodMs, registrations, samples } = result as {
+    periodMs: number;
+    registrations: string[];
+    samples: Tick[];
+  };
+  if (periodMs !== 50 || registrations.length !== 1) {
+    throw Error(
+      `Expected exactly one 50ms app interval. Observed registrations: ${JSON.stringify(registrations)}`,
+    );
+  }
+  return { periodMs, registration: registrations[0], samples };
+}
+
+function summarize(samples: number[]) {
+  if (
+    !samples.length ||
+    samples.some((sample) => !Number.isFinite(sample) || sample < 0)
+  ) {
+    throw Error("Missing or invalid timing samples.");
+  }
+  const sorted = [...samples].sort((a, b) => a - b);
+  return {
+    count: samples.length,
+    meanMs: samples.reduce((sum, ms) => sum + ms, 0) / samples.length,
+    p95Ms: sorted[Math.ceil(sorted.length * 0.95) - 1],
+    maxMs: sorted[sorted.length - 1],
+  };
+}
+
+async function runScenario(
+  browser: Browser,
+  root: string,
+  directory: string,
+  variant: VariantResult,
+  scenario: Scenario,
+) {
+  return withServer(root, directory, scenario, async (url, child) => {
+    const page = await browser.newPage({ viewport, deviceScaleFactor: 1 });
+    const browserLog = join(directory, `${scenario}.browser.log`);
+    writeFileSync(browserLog, "", { flag: "wx" });
+    const errors: string[] = [];
+    page.on("pageerror", (error) => errors.push(logError(error)));
+    page.on("console", (message) => {
+      if (message.type() === "error") errors.push(message.text());
+      if (["error", "warning"].includes(message.type())) {
+        appendFileSync(browserLog, `${message.type()} ${message.text()}\n`);
+      }
+    });
+    try {
+      await observeGameCanvas(page);
+      await page.goto(url, { timeout: 6000 });
+      const { renderer, frames, movementLegs } = await samplePage(
+        page,
+        scenario,
+        mockUi,
+      );
+      if (variant.renderer === "original-canvas" && renderer.type !== "2d")
+        throw Error(`Baseline renderer was ${renderer.type}, expected 2d.`);
+      if (
+        variant.renderer === "webgl-only-source-change" &&
+        !renderer.type.endsWith("webgl")
+      ) {
+        throw Error(
+          `The forced WebGL source variant rendered as ${renderer.type}.`,
+        );
+      }
+      const tick = await readTicks(child);
+      const ticks = tick.samples.filter(
+        ({ startEpochMs }) =>
+          startEpochMs >= frames.startEpochMs &&
+          startEpochMs < frames.endEpochMs,
+      );
+      const duration = frames.endEpochMs - frames.startEpochMs;
+      const metrics = {
+        browserRaf: {
+          ...summarize(frames.frameTimesMs),
+          averageFps: (frames.frameTimesMs.length * 1000) / duration,
+        },
+        serverCallback: {
+          ...summarize(ticks.map(({ durationMs }) => durationMs)),
+          observedHz: (ticks.length * 1000) / duration,
+        },
+      };
+      if (errors.length) throw Error(errors.join("\n"));
+      const screenshot = `${scenario}.png`;
+      await page.screenshot({
+        path: join(directory, screenshot),
+        timeout: 4000,
+      });
+      return {
+        status: "sampled" as const,
+        renderer,
+        durationMs: duration,
+        metrics,
+        frames,
+        movementLegs,
+        tick: {
+          periodMs: tick.periodMs,
+          registration: tick.registration,
+          samples: ticks,
+        },
+        workload:
+          scenario === "construction"
+            ? "isolated fixture: bridge materials already delivered, real UI starts work; performance only"
+            : scenario,
+        screenshot: `${variant.name}/${screenshot}`,
+      };
+    } catch (error) {
+      appendFileSync(
+        browserLog,
+        `${[...errors, logError(error)].join("\n")}\n`,
+      );
+      throw error;
+    } finally {
+      await page.close();
+    }
+  });
+}
+
+console.log(`Performance evidence: ${relative(repo, output)}`);
+try {
+  report.checkoutHead = (await exec("git", ["rev-parse", "HEAD"], {
+    cwd: repo,
+    env: gitEnv,
+    timeout: 5000,
+  })).stdout.trim();
+  try {
+    browser = await launchBrowser(toolEnv);
+    report.browser.version = browser.version();
+    report.browser.capability = await probeRenderer(browser);
+  } catch (error) {
+    report.browser.error = logError(error);
+    writeFileSync(join(output, "chromium.log"), `${report.browser.error}\n`);
+    console.error(report.browser.error);
+  }
+
+  for (const variant of report.variants) {
+    if (mode === "before")
+      variant.cases["dialogue-pending"] = {
+        status: "N/A",
+        reason: "Phase 1 baseline has no generated dialogue.",
+      };
+    if (interrupted) break;
+    if (variant.renderer === "webgl-only-source-change") {
+      const probe = report.browser.capability?.contexts;
+      if (!browser || (probe && !probe.webgl && !probe.experimentalWebgl)) {
+        variant.status = "unavailable";
+        variant.reason = !browser
+          ? "Chromium did not start."
+          : "This Chromium could not create either WebGL context used by Phaser 4.2.1.";
+        continue;
+      }
+    }
+    const directory = join(output, variant.name);
+    mkdirSync(directory);
+    try {
+      const root = await build(variant, directory);
+      if (!browser) {
+        // Exercise the real loopback listener independently of a Chromium launch failure.
+        await withServer(root, directory, "idle", async () => {});
+        throw Error("Chromium did not start. See chromium.log.");
+      }
+      for (const scenario of scenarios) {
+        if (interrupted) break;
+        if (variant.cases[scenario]) continue;
+        if (scenario === "dialogue-pending" && !mockUi) {
+          variant.cases[scenario] = {
+            status: "N/A",
+            reason: "After pending Mock UI configuration was not supplied.",
+          };
+          continue;
+        }
+        try {
+          variant.cases[scenario] = await runScenario(
+            browser,
+            root,
+            directory,
+            variant,
+            scenario,
+          );
+          console.log(`${variant.name}/${scenario}: sampled`);
+        } catch (error) {
+          variant.cases[scenario] = {
+            status: "failed",
+            reason: logError(error),
+          };
+          throw error;
+        }
+        writeFileSync(reportPath, `${JSON.stringify(report, null, 2)}\n`);
+      }
+      variant.status = "completed";
+      await delay(250);
+    } catch (error) {
+      variant.status = "failed";
+      variant.reason = logError(error);
+      console.error(`${variant.name}: ${variant.reason}`);
+    }
+  }
+} catch (error) {
+  report.error = logError(error);
+  console.error(report.error);
+} finally {
+  try {
+    await browser?.close();
+  } finally {
+    rmSync(saves, { recursive: true, force: true });
+    rmSync(temp, { recursive: true, force: true });
+    report.finishedAt = new Date().toISOString();
+    if (interrupted) report.error = `Interrupted by ${interrupted}.`;
+    writeFileSync(reportPath, `${JSON.stringify(report, null, 2)}\n`);
+    if (
+      report.error ||
+      report.browser.error ||
+      report.variants.some(({ status }) => status === "failed")
+    )
+      process.exitCode = 1;
+  }
+}
