+  mode,
+  expectedBaseline: baseline,
+  checkoutHead: "",
+  startedAt: new Date().toISOString(),
+  finishedAt: "",
+  environment: {
+    node: process.version,
+    platform: platform(),
+    kernel: release(),
+    architecture: arch(),
+    cpu: cpus()[0]?.model,
+    logicalCpus: cpus().length,
