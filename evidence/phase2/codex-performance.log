+import type { Browser } from "@playwright/test";
+import {
+  durationMs, launchBrowser, launchOptions, mockDelayMs, observeGameCanvas,
+  probeRenderer, samplePage, viewport, warmupMs, type MockUi, type Scenario,
+} from "./page.js";
+
+const baseline = "62c5c2a10dff3afc18dbe875341f3a274ca3b436";
+const repo = resolve(import.meta.dirname, "../..");
