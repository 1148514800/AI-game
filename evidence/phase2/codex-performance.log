import Fastify from "fastify";
import fastifyStatic from "@fastify/static";
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { WebSocket, WebSocketServer } from "ws";
import {
  clientMessage,
  schemaVersion,
  type ServerMessage,
} from "../shared/protocol.js";
import { tickMs, valley } from "../shared/world.js";
import { SaveFile } from "./save.js";
import { World } from "./world.js";

export function createApp(
  options: { savePath?: string; staticRoot?: string } = {},
) {
  const app = Fastify({ logger: false });
  const staticRoot = options.staticRoot ?? resolve("release/client");
  if (existsSync(staticRoot)) app.register(fastifyStatic, { root: staticRoot });

  let save: SaveFile | undefined;
  let world: World | undefined;
  let unavailable: string | undefined;
  try {
    save = new SaveFile(
      options.savePath ?? resolve("saves/foglamp-valley.sqlite"),
    );
    world = new World(save);
  } catch (error) {
    console.error("存档无法打开，已保留原件。", error);
    unavailable = "存档无法打开。请保留原件并检查 SQLite 文件与存档版本。";
  }

  app.get("/health", (_request, reply) => {
    const info = {
      phase: 1,
      schemaVersion,
      contentVersion: valley.contentVersion,
    };
    reply.header("Cache-Control", "no-store");
    if (unavailable)
      return reply
        .code(503)
        .send({ ...info, status: "save_error", message: unavailable });
    return { ...info, status: "ok" };
  });

  const ws = new WebSocketServer({ noServer: true, maxPayload: 1024 });
  let active: WebSocket | undefined;
  let paused = false;
  let lastPing = 0;
  let answered = true;
  let lastTick = performance.now();
  let lastSent = 0;
  let wasMoving = false;
  let wasWorking = false;

  function send(socket: WebSocket, message: ServerMessage) {
    if (socket.readyState !== WebSocket.OPEN) return;
    if (socket.bufferedAmount > 65536) {
      socket.terminate();
      return;
    }
    socket.send(JSON.stringify(message));
  }

  function storageError(error: unknown) {
    console.error("存档写入失败。", error);
    unavailable = "存档写入失败。请检查磁盘与存档，再重新启动服务。";
    world?.halt();
    if (active) {
      send(active, { type: "error", code: "SAVE_ERROR", text: unavailable });
      active.close(1011);
    }
  }

  function update(clock = performance.now()) {
    if (!active || !world) return;
    const snapshot = world.snapshot();
    send(active, snapshot);
    lastSent = clock;
    wasMoving = snapshot.moving;
    wasWorking = snapshot.working;
  }

  const timer = setInterval(() => {
    const clock = performance.now();
    const elapsed = clock - lastTick;
    lastTick = clock;
    if (!active || !world || unavailable) return;
    try {
      if (clock - lastPing >= 2000) {
        if (!answered) {
          world.halt();
          active.terminate();
          return;
        }
        if (active.readyState === WebSocket.OPEN) {
          answered = false;
          lastPing = clock;
          active.ping();
        }
      }
      world.tick(clock, elapsed);
      const { moving, working } = world.activity;
      if (
        moving ||
        working ||
        wasMoving ||
        wasWorking ||
        clock - lastSent >= 1000
      )
        update(clock);
    } catch (error) {
      storageError(error);
    }
  }, tickMs);
  timer.unref();

  app.server.on("upgrade", (request, socket, head) => {
    const origin = request.headers.origin;
    const host = request.headers.host ?? "";
    const isLoopback = /^(127\.0\.0\.1|localhost|\[::1\])(:\d+)?$/i.test(host);
    const sameOrigin =
      !origin || origin === `http://${host}` || origin === `https://${host}`;
    if (request.url !== "/ws" || !isLoopback || !sameOrigin) {
      socket.destroy();
      return;
    }
    ws.handleUpgrade(request, socket, head, (client) =>
      ws.emit("connection", client, request),
    );
  });

  ws.on("connection", (socket) => {
    socket.on("error", () => socket.terminate());
    if (!world || unavailable) {
      send(socket, {
        type: "error",
        code: "SAVE_ERROR",
        text: unavailable ?? "存档不可用。",
      });
      socket.close(1011);
      return;
    }
    const current = world;
    if (active) active.close(4001, "single player");
    current.halt();
    active = socket;
    paused = false;
    lastPing = performance.now();
    answered = true;
    socket.on("pong", () => {
      if (active === socket) answered = true;
    });
    let inputWindow = lastPing;
    let messages = 0;
    let actions = 0;

    socket.on("message", (raw, binary) => {
      if (active !== socket || unavailable) return;
      const clock = performance.now();
      if (clock - inputWindow >= 1000) {
        inputWindow = clock;
        messages = 0;
        actions = 0;
      }
      if (++messages > 90) {
        socket.close(1008, "input limit");
        return;
      }

      let input: unknown;
      try {
        input = binary ? null : JSON.parse(raw.toString());
      } catch {
        input = null;
      }
      const parsed = clientMessage.safeParse(input);
      if (!parsed.success) {
        send(socket, {
          type: "error",
          code: "INVALID_MESSAGE",
          text: "行动格式无效。",
        });
        return;
      }

      const message = parsed.data;
      try {
        switch (message.type) {
          case "move":
            if (!paused) current.setMovement(message, clock);
            break;
          case "pause":
            paused = message.paused;
            current.halt();
            current.flush();
            update(clock);
            break;
          case "action":
          case "reset": {
            if (++actions > 8 || (paused && message.type === "action")) {
              send(socket, {
                type: "result",
                id: message.id,
                ok: false,
                code: paused ? "PAUSED" : "RATE_LIMIT",
                text: paused ? "请先继续游玩。" : "操作太快，请稍等。",
              });
              break;
            }
            const result =
              message.type === "reset"
                ? current.reset(message)
                : current.perform(message);
            update(clock);
            send(socket, result);
            break;
          }
        }
      } catch (error) {
        storageError(error);
      }
    });

    socket.on("close", () => {
      if (active !== socket) return;
      active = undefined;
      current.halt();
      if (!unavailable) {
        try {
          current.flush();
        } catch (error) {
          storageError(error);
        }
      }
    });
    update();
  });

  app.addHook("preClose", async () => {
    clearInterval(timer);
    for (const socket of ws.clients) socket.terminate();
    active = undefined;
    if (!unavailable) {
      try {
        world?.flush();
      } catch (error) {
        storageError(error);
      }
    }
    ws.close();
  });
  app.addHook("onClose", async () => save?.close());
  return app;
}
import { existsSync, mkdirSync, statSync } from "node:fs";
import { dirname } from "node:path";
import { DatabaseSync } from "node:sqlite";
import {
  saveSchema,
  schemaVersion,
  type SaveState,
} from "../shared/protocol.js";
import { isPassable, resources, valley } from "../shared/world.js";

export function freshState(): SaveState {
  return {
    schemaVersion,
    contentVersion: valley.contentVersion,
    worldId: valley.id,
    player: { x: valley.spawn.x, y: valley.spawn.y, facing: "down" },
    inventory: { wood: 0, stone: 0, food: 0, toolbox: 0 },
    cooldowns: {},
    bridge: {
      discovered: false,
      wood: 0,
      stone: 0,
      progressMs: 0,
      repaired: false,
    },
    explored: false,
  };
}

function decode(payload: string): SaveState {
  const save = saveSchema.parse(JSON.parse(payload));
  const bridge = save.bridge;
  const full =
    bridge.wood === valley.bridge.required.wood &&
    bridge.stone === valley.bridge.required.stone;
  if (
    !isPassable(save.player.x, save.player.y, bridge.repaired) ||
    Object.keys(save.cooldowns).some((id) => !resources.has(id)) ||
    (!bridge.discovered && (bridge.wood !== 0 || bridge.stone !== 0)) ||
    (!full && bridge.progressMs !== 0) ||
    bridge.repaired !== (bridge.progressMs === valley.bridge.workMs) ||
    (save.explored && !bridge.repaired)
  ) {
    throw Error("存档内容与地图或工程规则不一致");
  }
  return save;
}

export class SaveFile {
  readonly initial: SaveState;
  private readonly db: DatabaseSync;
  private revision: number;

  constructor(path: string) {
    const existing = path !== ":memory:" && existsSync(path);
    if (existing && statSync(path).size === 0)
      throw Error("现有 SQLite 存档为空");
    if (path !== ":memory:") mkdirSync(dirname(path), { recursive: true });
    this.db = new DatabaseSync(path);
    try {
      this.db.exec("PRAGMA busy_timeout = 1500");
      if (!existing) {
        this.transaction(() => {
          this.db.exec(`
          CREATE TABLE world (
            slot INTEGER PRIMARY KEY CHECK(slot = 1),
            revision INTEGER NOT NULL,
            payload TEXT NOT NULL
          ) STRICT;
          CREATE TABLE receipts (id TEXT PRIMARY KEY) STRICT;
          PRAGMA user_version = ${schemaVersion};
          `);
          this.db
            .prepare("INSERT INTO world VALUES (1, 0, ?)")
            .run(JSON.stringify(freshState()));
        });
      }
      const integrity = this.db
        .prepare("PRAGMA quick_check")
        .get()?.quick_check;
      if (integrity !== "ok") throw Error("SQLite 完整性检查失败");
      if (
        this.db.prepare("PRAGMA user_version").get()?.user_version !==
        schemaVersion
      ) {
        throw Error("SQLite 存档版本不受支持");
      }
      const row = this.db
        .prepare("SELECT revision, payload FROM world WHERE slot = 1")
        .get();
      if (
        !row ||
        typeof row.payload !== "string" ||
        typeof row.revision !== "number" ||
        !Number.isSafeInteger(row.revision) ||
        row.revision < 0
      )
        throw Error("找不到有效的单人存档");
      this.db.prepare("SELECT id FROM receipts LIMIT 1").get();
      this.initial = decode(row.payload);
      this.revision = row.revision;
    } catch (error) {
      this.db.close();
      throw error;
    }
  }

  hasReceipt(id: string) {
    return Boolean(
      this.db.prepare("SELECT 1 FROM receipts WHERE id = ?").get(id),
    );
  }

  write(state: SaveState, receipt?: string) {
    this.transaction(() => {
      const change = this.db
        .prepare(
          "UPDATE world SET revision = revision + 1, payload = ? WHERE slot = 1 AND revision = ?",
        )
        .run(JSON.stringify(state), this.revision);
      if (change.changes !== 1) throw Error("存档已由另一个服务修改");
      if (receipt)
        this.db.prepare("INSERT INTO receipts VALUES (?)").run(receipt);
    });
    this.revision++;
  }

  close() {
    this.db.close();
  }

  private transaction(operation: () => void) {
    this.db.exec("BEGIN IMMEDIATE");
    try {
      operation();
      this.db.exec("COMMIT");
    } catch (error) {
      this.db.exec("ROLLBACK");
      throw error;
    }
  }
}
import { spawn } from "node:child_process";
// Spawn the actual Node services, not nested npm/shell wrappers. This keeps
// Ctrl+C and Playwright's process-tree cleanup reliable on macOS and Linux.
const children = [
  spawn(process.execPath, ["--import", "tsx", "src/server/index.ts"], {
    stdio: "inherit",
  }),
  spawn(
    process.execPath,
    ["node_modules/vite/bin/vite.js", "--host", "127.0.0.1"],
    { stdio: "inherit" },
  ),
];
let stopping = false;
function stop(code = 0) {
  if (stopping) return;
  stopping = true;
  for (const child of children) child.kill("SIGTERM");
  process.exitCode = code;
}
for (const child of children) {
  child.on("exit", (code) => stop(code ?? 0));
  child.on("error", (error) => {
    console.error(error.message);
    stop(1);
  });
}
process.on("SIGINT", () => stop());
process.on("SIGTERM", () => stop());
import { spawn } from "node:child_process";
import { once } from "node:events";
import { closeSync, mkdirSync, mkdtempSync, openSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { chromium, expect } from "@playwright/test";

const evidence = process.env.MISTSEA_EVIDENCE ?? "evidence/phase1";
mkdirSync(evidence, { recursive: true });
const directory = mkdtempSync(join(tmpdir(), "mistsea-production-"));
const output = openSync(join(evidence, "production-server.log"), "w");
const url = "http://127.0.0.1:3002";
const child = spawn(process.execPath, ["release/server/src/server/index.js"], {
  env: {
    PATH: process.env.PATH,
    PORT: "3002",
    HOST: "127.0.0.1",
    MISTSEA_SAVE: join(directory, "valley.sqlite"),
  },
  stdio: ["ignore", output, output],
});
let browser;

try {
  await expect
    .poll(
      async () => {
        if (child.exitCode !== null)
          throw Error(
            `Compiled server exited ${child.exitCode}; see production-server.log`,
          );
        try {
          return (await fetch(`${url}/health`)).json();
        } catch {
          return null;
        }
      },
      { timeout: 10000 },
    )
    .toMatchObject({
      status: "ok",
      phase: 1,
      schemaVersion: 1,
      contentVersion: 1,
    });
  browser = await chromium.launch();
  const page = await browser.newPage({
    viewport: { width: 1280, height: 960 },
  });
  const errors = [];
  page.on("pageerror", (error) => errors.push(error.message));
  page.on("console", (message) => {
    if (message.type() === "error") errors.push(message.text());
  });
  page.on("request", (request) => {
    if (
      new URL(request.url()).origin !== url &&
      !request.url().startsWith("data:")
    )
      errors.push(request.url());
  });
  page.on("response", (response) => {
    if (response.status() >= 400)
      errors.push(`${response.status()} ${response.url()}`);
  });
  await page.goto(url);
  const stage = page.locator("#game");
  await expect(stage).toHaveAttribute("data-ready", "true");
  await expect(page.locator("canvas")).toBeVisible();
  await expect(page.locator("#objective")).toHaveText("修复雾灯旧桥");
  const initial = Number(await stage.getAttribute("data-x"));
  await page.keyboard.down("d");
  try {
    await expect
      .poll(async () => Number(await stage.getAttribute("data-x")))
      .toBeGreaterThan(initial + 10);
  } finally {
    await page.keyboard.up("d");
  }
  await expect(stage).toHaveAttribute("data-moving", "false");
  await page.screenshot({
    path: join(evidence, "scene-production.png"),
    fullPage: true,
  });
  expect(errors).toEqual([]);
  console.log(
    "PASS: compiled Fastify, SQLite, WebSocket, local assets and keyboard movement without API keys.",
  );
} finally {
  if (browser) await browser.close();
  if (child.exitCode === null && child.signalCode === null) {
    const exit = once(child, "exit");
    child.kill("SIGTERM");
    await exit;
  }
  closeSync(output);
  rmSync(directory, { recursive: true, force: true });
}

