+      await loggedCommand(
+        process.execPath,
+        [
+          join(import.meta.dirname, "fixtures/construction.mjs"),
+          compiled,
+          savePath,
+        ],
+        root,
+        log,
+        5000,
+      );
+    } finally {
+      closeSync(log);
