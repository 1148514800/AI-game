# 本地游戏进程设置。Node 从 Shell 环境读取。
HOST=127.0.0.1
PORT=3001
MISTSEA_VITE_PORT=5173
MISTSEA_SAVE=saves/foglamp-valley.sqlite

# 默认使用明确标识的本地模拟对话。开启 Live 前需另行授权与配置。
LLM_ENABLED=false
# 填 Chat Completions 基础 URL，服务端追加 /chat/completions。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 按供应商和模型选择 max_tokens 或 max_completion_tokens（通常包含推理 Token）。
LLM_TOKEN_FIELD=max_tokens
# 仅用于支持 enable_thinking 的模型。硅基流动 Qwen3.5 可设为 false 加快对话。
LLM_ENABLE_THINKING=
LLM_TIMEOUT_MS=12000
LLM_MAX_OUTPUT_TOKENS=320
LLM_MAX_REQUESTS_PER_MINUTE=8
# 会话预算指 SQLite 持久滚动 60 分钟。同一存档重开、重启均不会重置。
LLM_MAX_REQUESTS_PER_SESSION=40
LLM_MAX_TOTAL_REQUESTS=500
LLM_MAX_TOTAL_TOKENS=500000
# Live 必填金额上限（美元）和两个每百万 Token 价格。Mock 不计美元。
LLM_MAX_TOTAL_USD=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
# 仅用于离线模拟。故障可选 timeout / rate-limit / network，留空为正常模拟。
LLM_MOCK_DELAY_MS=650
LLM_MOCK_FAILURE=

# Live 后台自主请求独立启用；默认只允许已配置的自由对话。
LLM_AUTONOMY_ENABLED=false
# 本地 Mock 自主模式独立启用；仅在 LLM_ENABLED=false 时生效。
LLM_MOCK_AUTONOMY_ENABLED=false
# 自主与对话同账本，自主另受请求数上限约束。
LLM_AUTONOMY_REQUESTS_PER_MINUTE=4
LLM_AUTONOMY_REQUESTS_PER_SESSION=24
LLM_AUTONOMY_MAX_TOTAL_REQUESTS=300
